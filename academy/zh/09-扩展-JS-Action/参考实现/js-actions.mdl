-- ============================================================
-- 模块 09：JS Action 扩展 — 参考实现
-- 前提：
--   1. 先运行模块 01（HD 模块必须存在）
--   2. 在 Studio Pro 中已创建以下 JavaScript Action：
--      - HD.JSA_CopyToClipboard（参数：Text: string，返回 void）
--        源码：参见 AI协作指南.md 附录
--      - HD.JSA_NotifyHighPriority（参数：Subject: string，返回 void）
--      - HD.JSA_FormatRelativeTime（参数：DateTime: DateTime，返回 string）
-- 运行：mxcli exec js-actions.mdl -p MyProject.mpr
-- ============================================================

-- ============================================================
-- 复制到剪贴板（调用 HD.JSA_CopyToClipboard JavaScript Action）
-- ============================================================

create or modify nanoflow HD.NF_CopyToClipboard
  ($Text: string)
  returns void
  folder 'UI'
{
  call javascript action HD.JSA_CopyToClipboard(Text = $Text);
}
/

-- ============================================================
-- 浏览器桌面通知（调用 HD.JSA_NotifyHighPriority JavaScript Action）
-- ============================================================

create or modify nanoflow HD.NF_NotifyHighPriority
  ($Subject: string)
  returns void
  folder 'UI'
{
  call javascript action HD.JSA_NotifyHighPriority(Subject = $Subject);
}
/

-- ============================================================
-- 相对时间格式化（调用 HD.JSA_FormatRelativeTime JavaScript Action）
-- ============================================================

create or modify nanoflow HD.NF_FormatRelativeTime
  ($DateTime: datetime)
  returns string as $Result
  folder 'UI'
{
  $Result = call javascript action HD.JSA_FormatRelativeTime(DateTime = $DateTime);
  return $Result;
}
/
