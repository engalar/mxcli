-- ============================================================
-- 模块 09：JS Action 扩展 — 参考实现
-- 前提：先运行模块 01（HD 模块必须存在）
-- 运行：mxcli exec js-actions.mdl -p MyProject.mpr
-- 注意：纯浏览器 API，无需外部依赖
-- ============================================================

-- ============================================================
-- JSA_CopyToClipboard：复制文本到剪贴板
-- ============================================================

create or modify javascript action HD.JSA_CopyToClipboard (
  text: string not null
) returns void
platform 'Web'
{
  imports $$
import "mx-global";
  $$
  code $$
return navigator.clipboard.writeText(text).then(function() {
  mx.ui.info('Copied to clipboard');
}).catch(function(err) {
  console.error('Copy failed: ' + err);
});
  $$
};

-- ============================================================
-- 复制到剪贴板纳流
-- ============================================================

create or modify nanoflow HD.NF_CopyToClipboard
  ($Text: string)
  returns void
  folder 'UI'
{
  call javascript action HD.JSA_CopyToClipboard(Text = $Text);
}
/

-- ============================================================
-- JSA_NotifyHighPriority：浏览器桌面通知
-- ============================================================

create or modify javascript action HD.JSA_NotifyHighPriority (
  subject: string not null
) returns void
platform 'Web'
{
  imports $$
import "mx-global";
  $$
  code $$
if (Notification.permission === 'granted') {
  new Notification('High Priority Ticket', { body: subject });
} else if (Notification.permission !== 'denied') {
  Notification.requestPermission().then(function(permission) {
    if (permission === 'granted') {
      new Notification('High Priority Ticket', { body: subject });
    }
  });
}
  $$
};

-- ============================================================
-- 浏览器桌面通知纳流
-- ============================================================

create or modify nanoflow HD.NF_NotifyHighPriority
  ($Subject: string)
  returns void
  folder 'UI'
{
  call javascript action HD.JSA_NotifyHighPriority(Subject = $Subject);
}
/

-- ============================================================
-- JSA_FormatRelativeTime：相对时间格式化
-- ============================================================

create or modify javascript action HD.JSA_FormatRelativeTime (
  dateTime: datetime not null
) returns string
platform 'Web'
{
  imports $$
import "mx-global";
  $$
  code $$
var now = new Date();
var diff = now.getTime() - dateTime.getTime();
var seconds = Math.floor(diff / 1000);
if (seconds < 60) { return 'just now'; }
var minutes = Math.floor(seconds / 60);
if (minutes < 60) { return minutes + 'm ago'; }
var hours = Math.floor(minutes / 60);
if (hours < 24) { return hours + 'h ago'; }
var days = Math.floor(hours / 24);
if (days < 30) { return days + 'd ago'; }
var months = Math.floor(days / 30);
return months + 'mo ago';
  $$
};

-- ============================================================
-- 相对时间格式化纳流
-- ============================================================

create or modify nanoflow HD.NF_FormatRelativeTime
  ($DateTime: datetime)
  returns string as $Result
  folder 'UI'
{
  $Result = call javascript action HD.JSA_FormatRelativeTime(DateTime = $DateTime);
  return $Result;
}
/
