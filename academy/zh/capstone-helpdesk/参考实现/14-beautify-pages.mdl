-- ============================================================
-- 模块 14：页面美化
-- 前提：01-13 已执行
--
-- 注意：DataGrid2 列 REPLACE 被执行器限制阻止
--       （DivContainer vs DataGrid2Column BSON），
--       因此 DataGrid 列中的 TicketStatusBadge 和 Priority
--       dynamictext 无法通过 ALTER PAGE 注入。
--       这些需要在页面创建时处理（在 04-pages.mdl 和
--       10-widget.mdl 中），而非通过 ALTER PAGE。
-- ============================================================

-- ============================================================
-- Step 1: Ticket_Overview — Status 列宽调整（140→120）
-- Note: TicketStatusBadge widget 已由 10-widget.mdl 安装，
-- 此处仅调整列宽。
-- ============================================================

alter page HD.Ticket_Overview {
  set size = 120 on dgTickets.Status
};

-- ============================================================
-- Step 2: Ticket_Detail — 美化（idempotent：先 DROP 再重建）
-- ============================================================

alter page HD.Ticket_Detail {
  drop widget badgeStatus, txtPriorityColor
};

alter page HD.Ticket_Detail {
  replace txtStatus with {
    dynamictext txtStatus (
      content: 'Status: {1}', contentparams: [{1} = Status]
    )
  }
  insert after txtStatus {
    dynamictext badgeStatus (
      content: '[{1}]', contentparams: [{1} = Status]
    )
  }
};

alter page HD.Ticket_Detail {
  insert after badgeStatus {
    dynamictext txtPriorityColor (
      content: 'Priority: {1}', contentparams: [{1} = Priority]
    )
  }
};

-- ============================================================
-- Step 3: KB.Article_Overview — 统一列属性
-- 注意：DataGrid2 REPLACE 被执行器限制阻止，
-- 因此使用 SET 代替 REPLACE 设置所有列属性。
-- ============================================================

alter page KB.Article_Overview {
  set attribute = PublishedAt on dgArticles.PublishedAt
};

alter page KB.Article_Overview {
  set Caption = 'Published' on dgArticles.PublishedAt
};

alter page KB.Article_Overview {
  set ColumnWidth = manual on dgArticles.PublishedAt
};

alter page KB.Article_Overview {
  set size = 140 on dgArticles.PublishedAt
};

-- ============================================================
-- Step 4: KB.Article_Detail — 操作按钮已在 06-kb.mdl 正确配置
-- DataView 的 FooterWidgets 以展开形式存储，没有 "ftrActions"
-- 命名的 BSON 节点，因此无需替换。
-- ============================================================

-- ============================================================
-- Step 5: Ticket_NewEdit — 表单区域分隔线
-- ============================================================

alter page HD.Ticket_NewEdit {
  drop widget txtDivider
};

alter page HD.Ticket_NewEdit {
  insert after rbPriority {
    dynamictext txtDivider (content: '───', rendermode: Text)
  }
};
