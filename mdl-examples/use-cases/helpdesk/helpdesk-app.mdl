-- ============================================================================
-- HelpDesk + KnowledgeBase — Full-Stack Application Baseline
-- ============================================================================
--
-- Purpose : End-to-end regression baseline (mx check must produce 0 new errors)
-- Modules : KnowledgeBase (KB), HelpDesk (HD)
-- Version : Mendix 11.6+ (workflow requires 11.0+)
-- Design  : docs/superpowers/specs/2026-05-22-helpdesk-app-design.md
-- Facts   : docs/mendix-platform-reference.md
--
-- Edge cases covered:
--   Domain    : self-ref association, cross-module association,
--               non-persistent entity, many-to-many via junction table
--   Microflow : 5-state status machine, rollback branch, time comparison,
--               constant reference (@Module.Const)
--   Nanoflow  : DB retrieve, call microflow, create+commit persistent,
--               pure-compute return value
--   Workflow  : parent-child, user task, multi-user task, decision (enum),
--               parallel split, jump, wait-for-notification,
--               interrupting + non-interrupting boundary events, annotation
--   Microflow workflow activities: all 13 (Call, ChangeState, CompleteTask,
--               ApplyJumpTo, GenerateJumpTo, RetrieveActivityRecords,
--               RetrieveContext, RetrieveWorkflows, ShowTaskPage,
--               ShowAdminPage, Lock, Unlock, Notify)
--   Security  : XPath row-level filters, module/user role mapping,
--               page/microflow grants, demo users
--   Navigation: role-derived menu visibility (no roles() on menu items)
--
-- Validation:
--   ./bin/mxcli check mdl-examples/use-cases/helpdesk/helpdesk-app.mdl
--
-- ============================================================================

-- MARK: KnowledgeBase — Module & Enumerations

create module KnowledgeBase;

create enumeration KB.ArticleStatus (
  Draft      'Draft',
  Published  'Published',
  Archived   'Archived'
);

-- MARK: KnowledgeBase — Entities

@position(100, 100)
create persistent entity KB.Category (
  Name:        string(200) not null,
  Description: string(500)
);

-- Self-referencing association: Category tree (parent → child)
create association KB.Category_Parent
  from KB.Category to KB.Category
  type reference
  owner left;

@position(400, 100)
create persistent entity KB.Tag (
  Name: string(100) not null unique
);

@position(700, 100)
create persistent entity KB.Article (
  Title:       string(500) not null,
  Content:     string,
  Status:      KB.ArticleStatus default Draft,
  PublishedAt: datetime,
  ViewCount:   integer default 0
)
index (Status)
index (PublishedAt);

create association KB.Article_Category
  from KB.Article to KB.Category
  type reference
  owner left;

-- Many-to-many junction table: Article <-> Tag
@position(700, 300)
create persistent entity KB.ArticleTag (
);

create association KB.ArticleTag_Article
  from KB.ArticleTag to KB.Article
  type reference
  owner left;

create association KB.ArticleTag_Tag
  from KB.ArticleTag to KB.Tag
  type reference
  owner left;

-- XPath row-level filter target: user sees only own ratings
@position(1000, 100)
create persistent entity KB.ArticleRating (
  Score:   integer not null,
  Comment: string(1000)
);

create association KB.ArticleRating_Article
  from KB.ArticleRating to KB.Article
  type reference
  owner left;

-- MARK: HelpDesk — Module & Enumerations

create module HelpDesk;

-- 5-state status machine — edge case: Reopen (state reversal)
create enumeration HD.TicketStatus (
  Draft      'Draft',
  Open       'Open',
  InProgress 'In Progress',
  Resolved   'Resolved',
  Closed     'Closed'
);

create enumeration HD.TicketPriority (
  Low      'Low',
  Normal   'Normal',
  High     'High',
  Critical 'Critical'
);

-- MARK: HelpDesk — Entities & Non-persistent

@position(100, 100)
create persistent entity HD.Customer (
  Name:    string(200) not null,
  Email:   string(200) not null,
  Company: string(200)
)
index (Email);

@position(400, 100)
create persistent entity HD.Agent (
  Name:     string(200) not null,
  Email:    string(200) not null,
  IsActive: boolean default true
);

@position(700, 100)
create persistent entity HD.Ticket (
  Subject:     string(500) not null,
  Description: string,
  Status:      HD.TicketStatus   default Draft,
  Priority:    HD.TicketPriority default Normal,
  SLADueAt:   datetime,
  ResolvedAt:  datetime,
  IsOverSLA:   boolean default false
)
index (Status)
index (Priority)
index (SLADueAt);

create association HD.Ticket_Customer
  from HD.Ticket to HD.Customer
  type reference
  owner left;

-- Nullable: ticket may not yet be assigned to an agent
create association HD.Ticket_Agent
  from HD.Ticket to HD.Agent
  type reference
  owner left;

@position(1000, 100)
create persistent entity HD.TicketComment (
  Content:    string not null,
  IsInternal: boolean default false
);

create association HD.TicketComment_Ticket
  from HD.TicketComment to HD.Ticket
  type reference
  owner left;

-- Workflow context entity for escalation approval
@position(700, 350)
create persistent entity HD.EscalationRequest (
  Reason:          string(1000) not null,
  RequestedAt:     datetime,
  RejectionReason: string(1000)
);

create association HD.EscalationRequest_Ticket
  from HD.EscalationRequest to HD.Ticket
  type reference
  owner left;

-- Non-persistent entity: ticket search / filter form
@position(100, 350)
create non-persistent entity HD.TicketSearch (
  SubjectKeyword: string(200),
  StatusFilter:   HD.TicketStatus,
  PriorityFilter: HD.TicketPriority
);

-- MARK: HelpDesk — Cross-Module Associations

-- Cross-module: ticket may link to a KB article (nullable)
create association HD.Ticket_KBArticle
  from HD.Ticket to KB.Article
  type reference
  owner left;

-- MARK: HelpDesk — Constants

-- SLA time limits per priority, configurable per environment
create constant HD.SLA_HIGH_HOURS
  type integer
  default 8
  comment 'SLA deadline in hours for High-priority tickets.';

create constant HD.SLA_CRITICAL_HOURS
  type integer
  default 2
  comment 'SLA deadline in hours for Critical-priority tickets. Configure shorter per environment.';

-- MARK: HelpDesk — Microflows (Status Machine)

-- ACT_Ticket_Submit: Draft → Open
-- Edge cases: Subject validation (rollback branch), SLA computed from constant
create or modify microflow HD.ACT_Ticket_Submit
  ($Ticket: HD.Ticket)
  returns boolean as $Success
begin
  @position(200, 200)
  if $Ticket/Subject = '' then
    @position(400, 200)
    validation feedback $Ticket/Subject message 'Subject is required';
    @position(400, 400)
    return false;
  end if;

  -- Compute SLA due date based on priority and environment-configurable constants
  @position(600, 200)
  declare $Hours integer = 24;
  if $Ticket/Priority = HD.TicketPriority.High then
    $Hours = @HD.SLA_HIGH_HOURS;
  end if;
  if $Ticket/Priority = HD.TicketPriority.Critical then
    $Hours = @HD.SLA_CRITICAL_HOURS;
  end if;

  @position(800, 200)
  change $Ticket (
    Status   = HD.TicketStatus.Open,
    SLADueAt = addHours('[%CurrentDateTime%]', $Hours)
  );
  @position(1000, 200)
  commit $Ticket;
  @position(1200, 200)
  return true;
end;
/

-- ACT_Ticket_Assign: Open → InProgress, set Agent
-- Edge case: pre-condition state assertion
create or modify microflow HD.ACT_Ticket_Assign
  ($Ticket: HD.Ticket, $Agent: HD.Agent)
  returns boolean as $Success
begin
  @position(200, 200)
  if $Ticket/Status != HD.TicketStatus.Open then
    @position(400, 200)
    show message warning 'Only Open tickets can be assigned.';
    @position(400, 400)
    return false;
  end if;
  @position(600, 200)
  change $Ticket (
    Status = HD.TicketStatus.InProgress,
    HD.Ticket_Agent = $Agent
  );
  @position(800, 200)
  commit $Ticket;
  @position(1000, 200)
  return true;
end;
/

-- ACT_Ticket_Resolve: InProgress → Resolved
-- Edge case: time comparison to set IsOverSLA flag
create or modify microflow HD.ACT_Ticket_Resolve
  ($Ticket: HD.Ticket)
  returns boolean as $Success
begin
  @position(200, 200)
  if $Ticket/Status != HD.TicketStatus.InProgress then
    @position(400, 200)
    return false;
  end if;
  @position(600, 200)
  declare $Now datetime = '[%CurrentDateTime%]';
  declare $IsOver boolean = $Now > $Ticket/SLADueAt and $Ticket/SLADueAt != empty;
  @position(800, 200)
  change $Ticket (
    Status     = HD.TicketStatus.Resolved,
    ResolvedAt = $Now,
    IsOverSLA  = $IsOver
  );
  @position(1000, 200)
  commit $Ticket;
  @position(1200, 200)
  return true;
end;
/

-- ACT_Ticket_Reopen: Resolved/Closed → Open
-- Edge case: state reversal (backward transition)
create or modify microflow HD.ACT_Ticket_Reopen
  ($Ticket: HD.Ticket)
  returns boolean as $Success
begin
  @position(200, 200)
  if $Ticket/Status != HD.TicketStatus.Resolved
     and $Ticket/Status != HD.TicketStatus.Closed then
    @position(400, 200)
    return false;
  end if;
  @position(600, 200)
  change $Ticket (
    Status     = HD.TicketStatus.Open,
    ResolvedAt = empty
  );
  @position(800, 200)
  commit $Ticket;
  @position(1000, 200)
  return true;
end;
/

-- ACT_Ticket_Close: Resolved → Closed (terminal transition)
create or modify microflow HD.ACT_Ticket_Close
  ($Ticket: HD.Ticket)
  returns boolean as $Success
begin
  @position(200, 200)
  if $Ticket/Status != HD.TicketStatus.Resolved then
    @position(400, 200)
    return false;
  end if;
  @position(600, 200)
  change $Ticket (Status = HD.TicketStatus.Closed);
  @position(800, 200)
  commit $Ticket;
  @position(1000, 200)
  return true;
end;
/

-- MARK: KnowledgeBase — Microflows

-- ACT_Article_Publish: Draft → Published, validate content
create or modify microflow KB.ACT_Article_Publish
  ($Article: KB.Article)
  returns boolean as $Success
begin
  @position(200, 200)
  if $Article/Content = '' or $Article/Content = empty then
    @position(400, 200)
    validation feedback $Article/Content message 'Content cannot be empty before publishing.';
    @position(400, 400)
    return false;
  end if;
  @position(600, 200)
  change $Article (
    Status      = KB.ArticleStatus.Published,
    PublishedAt = '[%CurrentDateTime%]'
  );
  @position(800, 200)
  commit $Article;
  @position(1000, 200)
  return true;
end;
/

-- ACT_Article_Archive: Published → Archived (terminal)
create or modify microflow KB.ACT_Article_Archive
  ($Article: KB.Article)
  returns boolean as $Success
begin
  @position(200, 200)
  change $Article (Status = KB.ArticleStatus.Archived);
  @position(400, 200)
  commit $Article;
  @position(600, 200)
  return true;
end;
/

-- MARK: HelpDesk — Nanoflows

-- NF_Ticket_QuickCreate: create + commit a Draft ticket from the client
-- Demonstrates: nanoflow creating and committing a persistent entity
create or modify nanoflow HD.NF_Ticket_QuickCreate
  ($Customer: HD.Customer, $Subject: string)
  returns HD.Ticket as $Ticket
begin
  @position(200, 200)
  $Ticket = create HD.Ticket (
    Subject  = $Subject,
    Status   = HD.TicketStatus.Draft,
    Priority = HD.TicketPriority.Normal,
    HD.Ticket_Customer = $Customer
  );
  @position(400, 200)
  commit $Ticket;
  @position(600, 200)
  return $Ticket;
end;
/

-- NF_TicketSearch_Apply: retrieve tickets matching search criteria
-- Demonstrates: nanoflow querying the database with XPath
create or modify nanoflow HD.NF_TicketSearch_Apply
  ($Search: HD.TicketSearch)
  returns list of HD.Ticket as $Tickets
begin
  @position(200, 200)
  retrieve $Tickets from database HD.Ticket
    where [
      ($Search/SubjectKeyword = empty or
       contains(Subject, $Search/SubjectKeyword))
      and ($Search/StatusFilter = empty or
           Status = $Search/StatusFilter)
      and ($Search/PriorityFilter = empty or
           Priority = $Search/PriorityFilter)
    ]
    limit 100;
  @position(600, 200)
  return $Tickets;
end;
/

-- NF_Priority_GetLabel: pure client-side computation, returns CSS class string
-- Demonstrates: nanoflow with no DB access, if/else chain, string return
create or modify nanoflow HD.NF_Priority_GetLabel
  ($Priority: HD.TicketPriority)
  returns string as $CSSClass
begin
  @position(200, 200)
  if $Priority = HD.TicketPriority.Critical then
    $CSSClass = 'badge-danger';
  else if $Priority = HD.TicketPriority.High then
    $CSSClass = 'badge-warning';
  else if $Priority = HD.TicketPriority.Normal then
    $CSSClass = 'badge-info';
  else
    $CSSClass = 'badge-default';
  end if;
  @position(800, 200)
  return $CSSClass;
end;
/

-- MARK: KnowledgeBase — Nanoflows

-- NF_Article_FormatPreview: call a microflow from a nanoflow
-- Demonstrates: nanoflow → microflow call (server-side truncation)
create or modify nanoflow KB.NF_Article_FormatPreview
  ($Article: KB.Article)
  returns string as $Preview
begin
  @position(200, 200)
  $Preview = call microflow KB.SUB_Article_TruncateContent(Article = $Article);
  @position(400, 200)
  return $Preview;
end;
/

-- Helper microflow called by NF_Article_FormatPreview
create or modify microflow KB.SUB_Article_TruncateContent
  ($Article: KB.Article)
  returns string as $Preview
begin
  @position(200, 200)
  declare $MaxLen integer = 200;
  if length($Article/Content) > $MaxLen then
    $Preview = substring($Article/Content, 0, $MaxLen) + '…';
  else
    $Preview = $Article/Content;
  end if;
  @position(600, 200)
  return $Preview;
end;
/

-- MARK: HelpDesk — Sub-Workflow (WF_SUB_ManagerReview)

-- Required pages for workflow (must exist before workflow is created)
create page HD.EscalationReview_Form
(
  title: 'Escalation Review',
  layout: Atlas_Core.Atlas_Default,
  params: { $WorkflowUserTask: System.WorkflowUserTask }
)
{
  layoutgrid lgMain {
    row rMain {
      column cMain (desktopwidth: 12) {
        dynamictext txtTitle (content: 'Manager Review', rendermode: H2)
      }
    }
  }
};

create page HD.EscalationWorkflow_Overview
(
  title: 'Escalation Workflow',
  layout: Atlas_Core.Atlas_Default,
  params: { $Workflow: System.Workflow }
)
{
  layoutgrid lgMain {
    row rMain {
      column cMain (desktopwidth: 12) {
        dynamictext txtTitle (content: 'Escalation Overview', rendermode: H2)
      }
    }
  }
};

-- User assignment targeting microflow (WFA_ prefix per naming conventions)
create or modify microflow HD.WFA_GetManagerAssignees
  ($workflow: System.Workflow, $EscalationRequest: HD.EscalationRequest)
  returns list of System.User as $Users
begin
  @position(200, 200)
  retrieve $Users from database System.User
    where [System.UserRoles/System.UserRole/Name = 'Manager'];
  @position(400, 200)
  return $Users;
end;
/

-- WFS_ microflows: called directly by workflow activities (WFS_ prefix)
create or modify microflow HD.WFS_SendReminder
  ($EscalationRequest: HD.EscalationRequest)
begin
  @position(200, 200)
  log info 'Escalation reminder sent for request ' + toString($EscalationRequest/Reason);
  @position(400, 200)
  return;
end;
/

create or modify microflow HD.WFS_Approve
  ($EscalationRequest: HD.EscalationRequest)
begin
  @position(200, 200)
  retrieve $Ticket from HD.EscalationRequest_Ticket/HD.Ticket
    over $EscalationRequest limit 1;
  @position(400, 200)
  if $Ticket != empty then
    change $Ticket (Priority = HD.TicketPriority.Critical);
    commit $Ticket;
  end if;
  @position(800, 200)
  return;
end;
/

create or modify microflow HD.WFS_Reject
  ($EscalationRequest: HD.EscalationRequest)
begin
  @position(200, 200)
  change $EscalationRequest (RejectionReason = 'Rejected by manager review board.');
  @position(400, 200)
  commit $EscalationRequest;
  @position(600, 200)
  return;
end;
/

-- Sub-workflow: single manager primary review, with fallback to majority vote
-- Workflow elements: Annotation, User task (+ non-interrupting boundary),
--                    Multi-user task, Decision (outcome), Call microflow,
--                    Multiple End events
create or replace workflow HD.WF_SUB_ManagerReview
  display 'Manager Review'
  overview page HD.EscalationWorkflow_Overview
  parameter $EscalationRequest: HD.EscalationRequest
  allow roles (HelpDesk.ManagerRole)
begin
  @annotation 'Primary manager reviews; escalates to senior board if needed.'
  user task UT_PrimaryReview
    page HD.EscalationReview_Form
    users microflow HD.WFA_GetManagerAssignees
    outcomes (Approve, Escalate)
    due date duration 1 days
  end;

  -- TODO: Non-interrupting boundary event on UT_PrimaryReview — 待引擎支持
  -- 预期语法（参见 24-workflow-examples.mdl）：
  --   alter workflow HD.WF_SUB_ManagerReview
  --     insert boundary event on UT_PrimaryReview
  --     non interrupting timer 'addHours([%CurrentDateTime%], 12)' {
  --       call microflow HD.WFS_SendReminder;
  --       return;
  --     }

  decision CheckPrimaryOutcome
    condition $UT_PrimaryReview/outcome
    outcomes (Approve, Escalate)
  end;

  -- Path A: approved by primary reviewer
  call microflow WFS_ApproveFromSub
    microflow HD.WFS_Approve
  end;
  return;

  -- Path B: escalate to senior review board (multi-user task)
  -- TODO: Multi-user task — 待引擎支持 ALTER WORKFLOW INSERT MULTI USER TASK
  -- 预期语法：
  --   alter workflow HD.WF_SUB_ManagerReview
  --     insert multi user task UT_SeniorReview
  --       after CheckPrimaryOutcome where outcome = Escalate
  --       page HD.EscalationReview_Form
  --       users microflow HD.WFA_GetManagerAssignees
  --       decision method majority
  --       outcomes (Approve, Reject)
  --     end;

  call microflow WFS_RejectFromSub
    microflow HD.WFS_Reject
  end;
  return;
end workflow;

-- MARK: HelpDesk — Parent Workflow (WF_TicketEscalation)

-- WFS_ microflows used by parent workflow
create or modify microflow HD.WFS_Escalation_Initialize
  ($EscalationRequest: HD.EscalationRequest)
begin
  @position(200, 200)
  change $EscalationRequest (RequestedAt = '[%CurrentDateTime%]');
  @position(400, 200)
  commit $EscalationRequest;
  @position(600, 200)
  return;
end;
/

create or modify microflow HD.WFS_AutoReject
  ($EscalationRequest: HD.EscalationRequest)
begin
  @position(200, 200)
  change $EscalationRequest (RejectionReason = 'Auto-rejected: no manager response within 48 hours.');
  @position(400, 200)
  commit $EscalationRequest;
  @position(600, 200)
  return;
end;
/

create or modify microflow HD.WFS_UpdateTicketPriority
  ($EscalationRequest: HD.EscalationRequest)
begin
  @position(200, 200)
  retrieve $Ticket from HD.EscalationRequest_Ticket/HD.Ticket
    over $EscalationRequest limit 1;
  @position(400, 200)
  if $Ticket != empty then
    change $Ticket (Priority = HD.TicketPriority.Critical, Status = HD.TicketStatus.InProgress);
    commit $Ticket;
  end if;
  @position(800, 200)
  return;
end;
/

create or modify microflow HD.WFS_NotifyAgent
  ($EscalationRequest: HD.EscalationRequest)
begin
  @position(200, 200)
  log info 'Agent notified: escalation approved for request ' + toString($EscalationRequest/Reason);
  @position(400, 200)
  return;
end;
/

-- Parent workflow: full escalation approval with all workflow element types
-- Elements: Annotation, Decision (Enumeration), Jump, Wait for notification,
--           Call workflow (parent→child), Parallel split, Multiple End events,
--           Interrupting + non-interrupting boundary events
create or replace workflow HD.WF_TicketEscalation
  display 'Ticket Escalation'
  overview page HD.EscalationWorkflow_Overview
  parameter $EscalationRequest: HD.EscalationRequest
  allow roles (HelpDesk.AgentRole, HelpDesk.ManagerRole)
begin
  @annotation 'Full escalation: Critical tickets auto-approve; others go through manager review.'

  call microflow InitializeEscalation
    microflow HD.WFS_Escalation_Initialize
  end;

  decision RouteByPriority
    condition $EscalationRequest/HD.EscalationRequest_Ticket/HD.Ticket/Priority
    outcomes (Critical, High, Normal, Low)
  end;

  -- Critical path: jump directly to end (no review needed)
  -- Demonstrates: Jump activity
  jump AutoApproveJump
    target End_AutoApproved
  end;

  -- Standard path: wait for a manager to become available
  -- Demonstrates: Wait for notification + non-interrupting boundary (repeat reminder)
  wait for notification WaitForManagerAvailable end;

  -- TODO: Non-interrupting repeating boundary event on WaitForManagerAvailable
  -- 预期语法：
  --   alter workflow HD.WF_TicketEscalation
  --     insert boundary event on WaitForManagerAvailable
  --     non interrupting timer 'addHours([%CurrentDateTime%], 12)' repeat every 12 hours {
  --       call microflow HD.WFS_SendReminder;
  --     }

  -- Call sub-workflow (parent → child)
  -- Demonstrates: Call workflow with interrupting 48h timeout boundary event
  call workflow SubReview
    workflow HD.WF_SUB_ManagerReview
    parameter $EscalationRequest = $EscalationRequest
  end;

  -- TODO: Interrupting boundary event on SubReview (48h timeout → auto-reject)
  -- 预期语法：
  --   alter workflow HD.WF_TicketEscalation
  --     insert boundary event on SubReview
  --     interrupting timer 'addHours([%CurrentDateTime%], 48)' {
  --       call microflow HD.WFS_AutoReject;
  --       return End_Timeout;
  --     }

  -- Parallel split: update ticket AND notify agent simultaneously
  -- Demonstrates: Parallel split with two concurrent microflow calls
  parallel split PostApprovalActions
    path PathA {
      call microflow UpdatePriority
        microflow HD.WFS_UpdateTicketPriority
      end;
    }
    path PathB {
      call microflow NotifyAgent
        microflow HD.WFS_NotifyAgent
      end;
    }
  end;

  return;

  -- End events (multiple, each named)
  end event End_AutoApproved;
  end event End_Completed;
  end event End_Timeout;
end workflow;

-- MARK: HelpDesk — Workflow Support Microflows (all 13 activities)

-- 1. Call workflow — trigger the escalation workflow from a button microflow
create or modify microflow HD.ACT_StartEscalation
  ($Ticket: HD.Ticket, $Reason: string)
  returns boolean as $Success
begin
  @position(200, 200)
  if $Ticket/Status != HD.TicketStatus.InProgress then
    return false;
  end if;
  @position(400, 200)
  $EscalationRequest = create HD.EscalationRequest (
    Reason          = $Reason,
    RequestedAt     = '[%CurrentDateTime%]',
    HD.EscalationRequest_Ticket = $Ticket
  );
  @position(600, 200)
  commit $EscalationRequest;
  @position(800, 200)
  -- Activity: Call workflow
  call workflow HD.WF_TicketEscalation with $EscalationRequest;
  @position(1000, 200)
  return true;
end;
/

-- 2. Workflow create event handler (WFC_ prefix)
create or modify microflow HD.WFC_EscalationRequest_OnCreate
  ($EscalationRequest: HD.EscalationRequest)
begin
  @position(200, 200)
  log info 'EscalationRequest created: ' + toString($EscalationRequest/Reason);
  @position(400, 200)
  return;
end;
/

-- 3. Change workflow state — demonstrates Pause / Unpause / Abort / Retry
create or modify microflow HD.ACT_Workflow_ChangeState
  ($Workflow: System.Workflow, $Operation: string)
begin
  @position(200, 200)
  if $Operation = 'Pause' then
    -- Activity: Change workflow state (Pause)
    pause workflow $Workflow;
  else if $Operation = 'Unpause' then
    -- Activity: Change workflow state (Unpause)
    unpause workflow $Workflow;
  else if $Operation = 'Abort' then
    -- Activity: Change workflow state (Abort)
    abort workflow $Workflow reason 'Manually aborted by administrator.';
  else if $Operation = 'Retry' then
    -- Activity: Change workflow state (Retry)
    retry workflow $Workflow;
  end if;
  @position(800, 200)
  return;
end;
/

-- 4. Complete user task (system-side completion)
create or modify microflow HD.ACT_Workflow_CompleteTask
  ($UserTask: System.WorkflowUserTask, $Outcome: string)
begin
  @position(200, 200)
  -- Activity: Complete user task
  complete user task $UserTask outcome $Outcome;
  @position(400, 200)
  return;
end;
/

-- 5+6. Generate jump-to options + Apply jump-to option
create or modify microflow HD.ACT_Workflow_JumpTo
  ($Workflow: System.Workflow)
begin
  @position(200, 200)
  -- Activity: Generate jump-to options
  $JumpOptions = generate jump-to options for $Workflow;
  @position(400, 200)
  -- (In practice: show page to let admin pick; here we take first option for demo)
  retrieve $SelectedOption from $JumpOptions limit 1;
  @position(600, 200)
  if $SelectedOption != empty then
    -- Activity: Apply jump-to option
    apply jump-to option $SelectedOption;
  end if;
  @position(800, 200)
  return;
end;
/

-- 7. Retrieve workflow activity records
create or modify microflow HD.ACT_Workflow_GetHistory
  ($Workflow: System.Workflow)
  returns list of System.WorkflowActivityRecord as $Records
begin
  @position(200, 200)
  -- Activity: Retrieve workflow activity records
  $Records = retrieve workflow activity records for $Workflow;
  @position(400, 200)
  return $Records;
end;
/

-- 8. Retrieve workflow context
create or modify microflow HD.ACT_Workflow_GetContext
  ($Workflow: System.Workflow)
  returns HD.EscalationRequest as $Context
begin
  @position(200, 200)
  -- Activity: Retrieve workflow context
  $Context = retrieve workflow context HD.EscalationRequest from $Workflow;
  @position(400, 200)
  return $Context;
end;
/

-- 9. Retrieve workflows (data source microflow, DS_ prefix)
create or modify microflow HD.DS_WorkflowInstances
  ($EscalationRequest: HD.EscalationRequest)
  returns list of System.Workflow as $Workflows
begin
  @position(200, 200)
  -- Activity: Retrieve workflows
  $Workflows = retrieve workflows for $EscalationRequest;
  @position(400, 200)
  return $Workflows;
end;
/

-- 10. Show user task page
create or modify microflow HD.ACT_Workflow_ShowTaskPage
  ($UserTask: System.WorkflowUserTask)
begin
  @position(200, 200)
  -- Activity: Show user task page
  show user task page $UserTask;
  @position(400, 200)
  return;
end;
/

-- 11. Show workflow admin page
create or modify microflow HD.ACT_Workflow_ShowAdminPage
  ($Workflow: System.Workflow)
begin
  @position(200, 200)
  -- Activity: Show workflow admin page
  show workflow page $Workflow;
  @position(400, 200)
  return;
end;
/

-- 12. Lock workflow
create or modify microflow HD.ACT_Workflow_Lock
  ($Workflow: System.Workflow)
begin
  @position(200, 200)
  -- Activity: Lock workflow (prevents new instances; pauses in-progress)
  lock workflow HD.WF_TicketEscalation pause instances true;
  @position(400, 200)
  return;
end;
/

-- 13. Unlock workflow
create or modify microflow HD.ACT_Workflow_Unlock
begin
  @position(200, 200)
  -- Activity: Unlock workflow (allows new instances; resumes paused)
  unlock workflow HD.WF_TicketEscalation unpause instances true;
  @position(400, 200)
  return;
end;
/

-- Notify workflow (triggers Wait for notification in WF_TicketEscalation)
create or modify microflow HD.ACT_Workflow_Notify
  ($Workflow: System.Workflow)
  returns boolean as $Notified
begin
  @position(200, 200)
  -- Activity: Notify workflow
  $Notified = notify workflow $Workflow activity 'WaitForManagerAvailable';
  @position(400, 200)
  return $Notified;
end;
/

-- MARK: Pages — KnowledgeBase

create page KB.Article_Overview
(
  title: 'Knowledge Base',
  layout: Atlas_Core.Atlas_Default
)
{
  layoutgrid lgMain {
    row rMain {
      column cMain (desktopwidth: 12) {
        -- Gallery: Published articles with nanoflow-rendered preview
        -- Datasource: database KB.Article where Status = Published
        gallery galArticles (
          datasource: database KB.Article
            where [Status = 'Published'],
          pagesize: 12
        ) {
          container ctnCard {
            dynamictext txtTitle (content: {Article/Title})
          }
        }
        -- Action: new article (visible only to Contributor/Admin via page access)
        actionbutton btnNewArticle (caption: 'New Article', onclick: show page KB.Article_NewEdit)
      }
    }
  }
};

create page KB.Article_Detail
(
  title: 'Article',
  layout: Atlas_Core.Atlas_Default,
  params: { $Article: KB.Article }
)
{
  layoutgrid lgMain {
    row rMain {
      column cMain (desktopwidth: 9) {
        dataview dvArticle (datasource: $Article) {
          dynamictext txtTitle   (content: {Title},   rendermode: H1)
          dynamictext txtContent (content: {Content})
          -- ReferenceSetSelector for many-to-many Tags
          referencesetselector rssTags (
            association: KB.ArticleTag_Tag,
            caption: 'Tags'
          )
        }
      }
      column cSidebar (desktopwidth: 3) {
        -- Ratings DataGrid: XPath filters to current user's ratings only
        datagrid dgRatings (
          datasource: database KB.ArticleRating
            where [KB.ArticleRating_Article = $Article
                   and System.owner = '[%CurrentUser%]'],
          caption: 'My Ratings'
        ) {
          column colScore   (attribute: Score,   caption: 'Score')
          column colComment (attribute: Comment, caption: 'Comment')
        }
      }
    }
  }
};

-- MARK: Pages — HelpDesk

create page HD.Ticket_Overview
(
  title: 'Tickets',
  layout: Atlas_Core.Atlas_Default
)
{
  layoutgrid lgMain {
    row rMain {
      column cMain (desktopwidth: 12) {
        -- DataGrid2 with column-level filters (textfilter + dropdownfilter)
        datagrid2 dg2Tickets (
          datasource: database HD.Ticket,
          pagesize: 20
        ) {
          column colSubject  (attribute: Subject,  caption: 'Subject') {
            textfilter fltSubject
          }
          column colStatus   (attribute: Status,   caption: 'Status') {
            dropdownfilter fltStatus
          }
          column colPriority (attribute: Priority, caption: 'Priority') {
            dropdownfilter fltPriority
          }
          column colSLADue   (attribute: SLADueAt, caption: 'SLA Due')
          column colIsOver   (attribute: IsOverSLA, caption: 'Overdue')
        }
        actionbutton btnNewTicket (caption: 'New Ticket', onclick: show page HD.Ticket_NewEdit)
      }
    }
  }
};

-- Detail page: cross-module ref, conditional visibility, workflow trigger
create page HD.Ticket_Detail
(
  title: 'Ticket',
  layout: Atlas_Core.Atlas_Default,
  params: { $Ticket: HD.Ticket }
)
{
  layoutgrid lgMain {
    row rHeader {
      column cHeader (desktopwidth: 12) {
        dataview dvTicket (datasource: $Ticket) {
          dynamictext txtSubject  (content: {Subject},   rendermode: H2)
          dynamictext txtStatus   (content: {Status})
          dynamictext txtPriority (content: {Priority})
          -- Agent assignment (ReferenceSelector)
          referenceselector rsAgent (association: HD.Ticket_Agent, caption: 'Assigned Agent')
          -- Cross-module: link to KB article
          referenceselector rsKBArticle (association: HD.Ticket_KBArticle, caption: 'Related KB Article')
        }
      }
    }
    row rActions {
      column cActions (desktopwidth: 12) {
        actionbutton btnSubmit  (caption: 'Submit',  onclick: call microflow HD.ACT_Ticket_Submit(Ticket = $Ticket))
        actionbutton btnResolve (caption: 'Resolve', onclick: call microflow HD.ACT_Ticket_Resolve(Ticket = $Ticket))
        actionbutton btnReopen  (caption: 'Reopen',  onclick: call microflow HD.ACT_Ticket_Reopen(Ticket = $Ticket))
        actionbutton btnEscalate (caption: 'Request Escalation', onclick: show page HD.EscalationStart_Form)
      }
    }
    row rComments {
      column cComments (desktopwidth: 12) {
        -- All comments visible to Agent/Manager; internal comments hidden from Customer
        -- (visibility controlled by entity access XPath on HD.TicketComment.IsInternal)
        datagrid dgComments (
          datasource: database HD.TicketComment
            where [HD.TicketComment_Ticket = $Ticket],
          caption: 'Comments'
        ) {
          column colContent    (attribute: Content,    caption: 'Comment')
          column colIsInternal (attribute: IsInternal, caption: 'Internal')
        }
      }
    }
  }
};

-- Popup: non-persistent entity search form
-- Demonstrates: non-persistent entity DataView + nanoflow reset + popup layout
create page HD.TicketSearch_Form
(
  title: 'Search Tickets',
  layout: Atlas_Core.PopupLayout,
  params: { $Search: HD.TicketSearch }
)
{
  dataview dvSearch (datasource: $Search) {
    textbox tbKeyword  (attribute: SubjectKeyword, caption: 'Subject contains')
    dropdown ddStatus  (attribute: StatusFilter,   caption: 'Status')
    dropdown ddPriority (attribute: PriorityFilter, caption: 'Priority')
  }
  actionbutton btnSearch (caption: 'Search', onclick: call nanoflow HD.NF_TicketSearch_Apply(Search = $Search))
  actionbutton btnClose  (caption: 'Close',  onclick: close page)
};

