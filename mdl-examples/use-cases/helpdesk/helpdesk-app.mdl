-- MARK: Security — Module Roles

-- KnowledgeBase: 3 module roles
create module role KB.Reader;
create module role KB.Contributor;
create module role KB.Admin;

-- HelpDesk: 3 module roles (no Admin module role — admin access via user role composition)
create module role HD.CustomerRole;
create module role HD.AgentRole;
create module role HD.ManagerRole;

-- MARK: Security — User Roles & Grants

-- Entity access — KnowledgeBase

-- KB.Reader: only Published articles (XPath), own ratings only
grant KB.Reader on KB.Article (read *)
  where '[Status = ''Published'']';
grant KB.Reader on KB.Category (read *);
grant KB.Reader on KB.Tag (read *);
grant KB.Reader on KB.ArticleRating (read *, write *)
  where '[System.owner = ''[%CurrentUser%]'']';
grant KB.Reader on KB.ArticleTag (read *);

-- KB.Contributor: full article lifecycle
grant KB.Contributor on KB.Article (create, read *, write *, delete);
grant KB.Contributor on KB.ArticleRating (create, read *, write *, delete);
grant KB.Contributor on KB.ArticleTag (create, read *, write *, delete);
grant KB.Contributor on KB.Category (create, read *, write *);
grant KB.Contributor on KB.Tag (create, read *, write *);

-- KB.Admin: unrestricted
grant KB.Admin on KB.Article (create, read *, write *, delete);
grant KB.Admin on KB.ArticleRating (create, read *, write *, delete);
grant KB.Admin on KB.ArticleTag (create, read *, write *, delete);
grant KB.Admin on KB.Category (create, read *, write *, delete);
grant KB.Admin on KB.Tag (create, read *, write *, delete);

-- Microflow / nanoflow grants — KnowledgeBase
grant execute KB.ACT_Article_Publish to KB.Contributor, KB.Admin;
grant execute KB.ACT_Article_Archive to KB.Contributor, KB.Admin;
grant execute KB.NF_Article_FormatPreview to KB.Reader, KB.Contributor, KB.Admin;

-- Entity access — HelpDesk

-- CustomerRole: own tickets only (XPath on Ticket_Customer association)
grant HD.CustomerRole on HD.Ticket (create, read *, write Subject, write Description)
  where '[HD.Ticket_Customer/HD.Customer/System.owner = ''[%CurrentUser%]'']';
grant HD.CustomerRole on HD.TicketComment (create, read *)
  where '[IsInternal = false]';
grant HD.CustomerRole on HD.Customer (read *, write *);
grant HD.CustomerRole on HD.TicketSearch (read *, write *);

-- AgentRole: all tickets, all comments including Internal
grant HD.AgentRole on HD.Ticket (create, read *, write *);
grant HD.AgentRole on HD.TicketComment (create, read *, write *);
grant HD.AgentRole on HD.Customer (read *);
grant HD.AgentRole on HD.Agent (read *);
grant HD.AgentRole on HD.EscalationRequest (create, read *);
grant HD.AgentRole on HD.TicketSearch (read *, write *);

-- ManagerRole: AgentRole + approve escalations + delete tickets
grant HD.ManagerRole on HD.Ticket (create, read *, write *, delete);
grant HD.ManagerRole on HD.TicketComment (create, read *, write *, delete);
grant HD.ManagerRole on HD.Customer (read *, write *);
grant HD.ManagerRole on HD.Agent (read *, write *);
grant HD.ManagerRole on HD.EscalationRequest (create, read *, write *, delete);
grant HD.ManagerRole on HD.TicketSearch (read *, write *);

-- Microflow / nanoflow grants — HelpDesk
grant execute HD.ACT_Ticket_Submit  to HD.CustomerRole, HD.AgentRole, HD.ManagerRole;
grant execute HD.ACT_Ticket_Assign  to HD.AgentRole, HD.ManagerRole;
grant execute HD.ACT_Ticket_Resolve to HD.AgentRole, HD.ManagerRole;
grant execute HD.ACT_Ticket_Reopen  to HD.AgentRole, HD.ManagerRole;
grant execute HD.ACT_Ticket_Close   to HD.AgentRole, HD.ManagerRole;
grant execute HD.ACT_StartEscalation to HD.AgentRole, HD.ManagerRole;
grant execute HD.ACT_Workflow_ChangeState  to HD.ManagerRole;
grant execute HD.ACT_Workflow_Lock         to HD.ManagerRole;
grant execute HD.ACT_Workflow_Unlock       to HD.ManagerRole;
grant execute HD.ACT_Workflow_Notify       to HD.ManagerRole;
grant execute HD.NF_Priority_GetLabel      to HD.CustomerRole, HD.AgentRole, HD.ManagerRole;
grant execute HD.NF_TicketSearch_Apply     to HD.CustomerRole, HD.AgentRole, HD.ManagerRole;
grant execute HD.NF_Ticket_QuickCreate     to HD.CustomerRole, HD.AgentRole;

-- Page grants
grant view HD.Ticket_Overview      to HD.CustomerRole, HD.AgentRole, HD.ManagerRole;
grant view HD.Ticket_Detail        to HD.CustomerRole, HD.AgentRole, HD.ManagerRole;
grant view HD.TicketSearch_Form    to HD.CustomerRole, HD.AgentRole, HD.ManagerRole;
grant view HD.EscalationReview_Form   to HD.ManagerRole;
grant view HD.EscalationWorkflow_Overview to HD.ManagerRole;
grant view KB.Article_Overview     to KB.Reader, KB.Contributor, KB.Admin;
grant view KB.Article_Detail       to KB.Reader, KB.Contributor, KB.Admin;

-- User roles: 4, mapping module roles
-- Note: Administrator uses Administration module built-in + composition of module roles

create user role Customer
  module roles (HD.CustomerRole, KB.Reader);

create user role Agent
  module roles (HD.AgentRole, KB.Contributor);

create user role Manager
  module roles (HD.ManagerRole, KB.Contributor);

create user role Administrator
  module roles (HD.ManagerRole, KB.Admin);

-- Application security level + demo users
alter project security (
  security level: production,
  demo users: true
);

create demo user 'demo_customer@helpdesk.test' (
  password: 'Demo1234!',
  user role: Customer
);

create demo user 'demo_agent@helpdesk.test' (
  password: 'Demo1234!',
  user role: Agent
);

create demo user 'demo_manager@helpdesk.test' (
  password: 'Demo1234!',
  user role: Manager
);

-- MARK: Navigation

-- Responsive profile: role-derived visibility (no roles() on menu items —
-- visibility is automatically derived from page access permissions)
create or replace navigation Responsive
  home page HD.Ticket_Overview
  login page Administration.login
  menu (
    menu item '我的工单'  page HD.Ticket_Overview;
    menu item '知识库'    page KB.Article_Overview;
    menu '工单管理' (
      menu item '所有工单'  page HD.Ticket_Overview;
      menu item '升级审批'  page HD.EscalationReview_Form;
      menu item '工作流管理' page HD.EscalationWorkflow_Overview;
    );
    menu item '系统管理' page Administration.Account_Overview;
  );
