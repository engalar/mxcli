-- ============================================================
-- SHOWCASE: System Variables in XPath
-- Mendix doc: /refguide/xpath/
-- MDL grammar rule: xpathConstraint (system variables)
-- ============================================================

create module Showcase;

-- [XPATH-06] [%CurrentDateTime%] 在 where 子句
create microflow Showcase.XPath_SysVar_01 ()
returns list of Showcase.Order as $r
begin
  retrieve $r from Showcase.Order
    where [OrderDate < '[%CurrentDateTime%]' and IsActive = true];
  return $r;
end;
/
