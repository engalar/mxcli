-- ============================================================
-- SHOWCASE: XPath Basic Tokens
-- Mendix doc: /refguide/xpath/
-- MDL grammar rule: retrieveStatement + xpathConstraint
-- ============================================================

create module Showcase;

-- [XPATH-01] 基本路径语法在 retrieve where 子句
create microflow Showcase.XPath_Tokens_01 ()
returns list of Showcase.Order as $r
{
  retrieve $r from Showcase.Order
    where [IsActive = true];
  return $r;
}
/
