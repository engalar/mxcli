-- ============================================================
-- SHOWCASE: Show Message Activity
-- Mendix doc: /refguide/show-message/
-- MDL grammar rule: showMessageStatement
-- Syntax: SHOW MESSAGE expression (TYPE info|warning|error)?
-- ============================================================

create module Showcase;

-- [ACT-MSG-01] info message
create microflow Showcase.Act_Msg_01 ()
returns Nothing
{
  show message 'Order saved successfully.' type info;
}
/

-- [ACT-MSG-02] warning message
create microflow Showcase.Act_Msg_02 ()
returns Nothing
{
  show message 'Please review the order.' type warning;
}
/

-- [ACT-MSG-03] error message
create microflow Showcase.Act_Msg_03 ()
returns Nothing
{
  show message 'Order could not be processed.' type error;
}
/
