-- ============================================================
-- SHOWCASE: Date Between Functions
-- Mendix doc: /refguide/date-range-function-calls/
-- MDL grammar rule: functionCallExpression
-- ============================================================

create module Showcase;

-- [EXPR-DATE-BTW-01] daysBetween, weeksBetween, monthsBetween, yearsBetween
create microflow Showcase.Expr_DateBetween_01 ($from: datetime, $to: datetime)
returns integer as $r
begin
  declare $r: integer = daysBetween($from, $to);
  return $r;
end;
/

-- [EXPR-DATE-BTW-02] hoursBetween, minutesBetween, secondsBetween
create microflow Showcase.Expr_DateBetween_02 ($from: datetime, $to: datetime)
returns integer as $r
begin
  declare $r: integer = hoursBetween($from, $to);
  return $r;
end;
/

-- [EXPR-DATE-BTW-03] yearsBetween, monthsBetween, weeksBetween
create microflow Showcase.Expr_DateBetween_03 ($from: datetime, $to: datetime)
returns Nothing
begin
  declare $y: integer = yearsBetween($from, $to);
  declare $m: integer = monthsBetween($from, $to);
  declare $w: integer = weeksBetween($from, $to);
end;
/

-- [EXPR-DATE-BTW-04] secondsBetween, millisecondsBetween
create microflow Showcase.Expr_DateBetween_04 ($from: datetime, $to: datetime)
returns Nothing
begin
  declare $s: integer = secondsBetween($from, $to);
  declare $ms: integer = millisecondsBetween($from, $to);
end;
/
