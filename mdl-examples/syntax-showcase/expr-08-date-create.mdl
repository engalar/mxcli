-- ============================================================
-- SHOWCASE: Date/Time Creation Functions
-- Mendix doc: /refguide/date-creation-function-calls/
-- MDL grammar rule: functionCallExpression
-- ============================================================

create module Showcase;

-- [EXPR-DATE-CREATE-01] dateTime
create microflow Showcase.Expr_DateCreate_01 ()
returns datetime as $r
{
  declare $r: datetime = dateTime(2024, 1, 15, 9, 0, 0);
  return $r;
}
/

-- [EXPR-DATE-CREATE-02] dateTimeUTC
create microflow Showcase.Expr_DateCreate_02 ()
returns datetime as $r
{
  declare $r: datetime = dateTimeUTC(2024, 6, 1, 12, 0, 0);
  return $r;
}
/
