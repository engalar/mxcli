-- ============================================================
-- SHOWCASE: Add/Remove from List
-- Mendix doc: /refguide/change-list/
-- MDL grammar rule: addToListStatement, removeFromListStatement
-- ============================================================

create module Showcase;

-- [ACT-LIST-CHANGE-01] add to list
create microflow Showcase.Act_ListChange_01 ($list: list of Showcase.Product, $item: Showcase.Product)
returns Nothing
{
  add $item to $list;
}
/

-- [ACT-LIST-CHANGE-02] remove from list
create microflow Showcase.Act_ListChange_02 ($list: list of Showcase.Product, $item: Showcase.Product)
returns Nothing
{
  remove $item from $list;
}
/
