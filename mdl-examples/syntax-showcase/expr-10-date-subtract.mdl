-- ============================================================
-- SHOWCASE: Date Subtract Functions
-- Mendix doc: /refguide/subtract-date-function-calls/
-- MDL grammar rule: functionCallExpression
-- ============================================================

create module Showcase;

-- [EXPR-DATE-SUB-01] subtractDays
create microflow Showcase.Expr_DateSub_01 ($d: datetime)
returns datetime as $r
{
  declare $r: datetime = subtractDays($d, 7);
  return $r;
}
/

-- [EXPR-DATE-SUB-02] subtractMonths, subtractYears
create microflow Showcase.Expr_DateSub_02 ($d: datetime)
returns datetime as $r
{
  declare $r: datetime = subtractMonths($d, 1);
  return $r;
}
/

-- [EXPR-DATE-SUB-03] subtractYears, subtractWeeks, subtractQuarters
create microflow Showcase.Expr_DateSub_03 ($d: datetime)
returns Nothing
{
  declare $d1: datetime = subtractYears($d, 1);
  declare $d2: datetime = subtractWeeks($d, 1);
  declare $d3: datetime = subtractQuarters($d, 1);
}
/

-- [EXPR-DATE-SUB-04] subtractHours, subtractMinutes, subtractSeconds, subtractMilliseconds
create microflow Showcase.Expr_DateSub_04 ($d: datetime)
returns Nothing
{
  declare $d1: datetime = subtractHours($d, 2);
  declare $d2: datetime = subtractMinutes($d, 30);
  declare $d3: datetime = subtractSeconds($d, 60);
  declare $d4: datetime = subtractMilliseconds($d, 500);
}
/
