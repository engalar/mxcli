-- ============================================================
-- SHOWCASE: Change Object Activity
-- Mendix doc: /refguide/change-object/
-- MDL grammar rule: changeObjectStatement
-- ============================================================

create module Showcase;

-- [ACT-CHANGE-01] 基本 change
create microflow Showcase.Act_Change_01 ($order: Showcase.Order)
returns Nothing
{
  change $order (
    Status = Showcase.OrderStatus.Active,
    IsActive = true
  );
}
/

-- [ACT-CHANGE-02] change + REFRESH
create microflow Showcase.Act_Change_02 ($order: Showcase.Order)
returns Nothing
{
  change $order (IsActive = false) refresh;
}
/
