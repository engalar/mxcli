-- ============================================================
-- SHOWCASE: String Functions
-- Mendix doc: /refguide/string-function-calls/
-- MDL grammar rule: functionCallExpression
-- ============================================================

create module Showcase;

-- [EXPR-STR-01] contains, startsWith, endsWith
create microflow Showcase.Expr_Str_01 ($s: string)
returns boolean as $r
{
  declare $r: boolean = contains($s, 'foo') or startsWith($s, 'bar') or endsWith($s, 'baz');
  return $r;
}
/

-- [EXPR-STR-02] toLowerCase, toUpperCase, trim, length
create microflow Showcase.Expr_Str_02 ($s: string)
returns string as $r
{
  declare $r: string = trim(toLowerCase($s));
  return $r;
}
/

-- [EXPR-STR-03] substring, find
create microflow Showcase.Expr_Str_03 ($s: string)
returns string as $r
{
  declare $r: string = substring($s, 0, 5);
  return $r;
}
/

-- [EXPR-STR-04] replaceAll
create microflow Showcase.Expr_Str_04 ($s: string)
returns string as $r
{
  declare $r: string = replaceAll($s, 'foo', 'bar');
  return $r;
}
/

-- [EXPR-STR-05] urlEncode, urlDecode
create microflow Showcase.Expr_Str_05 ($s: string)
returns string as $r
{
  declare $r: string = urlEncode($s);
  return $r;
}
/

-- [EXPR-STR-06] htmlEncode
create microflow Showcase.Expr_Str_06 ($s: string)
returns string as $r
{
  declare $r: string = htmlEncode($s);
  return $r;
}
/

-- [EXPR-STR-07] length
create microflow Showcase.Expr_Str_07 ($s: string)
returns integer as $r
{
  declare $r: integer = length($s);
  return $r;
}
/
