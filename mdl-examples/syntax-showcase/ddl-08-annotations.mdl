-- ============================================================
-- SHOWCASE: Annotations (@caption, @position, @excluded, @comment)
-- MDL grammar rule: annotation
-- ============================================================

create module Showcase;

-- [DDL-ANN-01] @position annotation on entity
@position(100, 200)
create persistent entity Showcase.AnnotatedEntity (
  Name: string(200)
);
/

-- [DDL-ANN-02] @caption + @position on microflow
@caption('Process Order')
@position(300, 100)
create microflow Showcase.Annotated_MF ()
returns Nothing
{
  return;
}
/

-- [DDL-ANN-03] @excluded（排除出发布版本）
@excluded
create microflow Showcase.Dev_Helper ()
returns Nothing
{
  return;
}
/
