-- ============================================================
-- SHOWCASE: Import/Export with Mapping
-- Mendix doc: /refguide/import-mapping-action/
-- MDL grammar rule: importFromMappingStatement, exportToMappingStatement
-- Syntax: [$Var =] IMPORT FROM MAPPING Module.IMM($Source)
--         [$Var =] EXPORT TO MAPPING Module.EMM($Source)
-- ============================================================

create module Showcase;

-- [ACT-MAP-01] import from mapping
create microflow Showcase.Act_Import_01 ($json: string)
returns Showcase.Order as $r
{
  declare $r: Showcase.Order = empty;
  $r = import from mapping Showcase.OrderImportMapping ($json);
  return $r;
}
/

-- [ACT-MAP-02] export to mapping
create microflow Showcase.Act_Export_01 ($order: Showcase.Order)
returns string as $r
{
  declare $r: string = empty;
  $r = export to mapping Showcase.OrderExportMapping ($order);
  return $r;
}
/
