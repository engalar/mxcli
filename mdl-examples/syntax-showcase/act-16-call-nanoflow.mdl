-- ============================================================
-- SHOWCASE: Call Nanoflow Activity
-- Mendix doc: /refguide/nanoflow-call/
-- MDL grammar rule: callNanoflowStatement
-- ============================================================

create module Showcase;

create nanoflow Showcase.NF_Target ($name: string)
returns string as $out
{
  declare $out: string = $name;
  return $out;
}
/

-- [NF-CALL-01] 有返回值
create microflow Showcase.Act_NanoCall_01 ()
returns string as $r
{
  declare $r: string = empty;
  $r = call nanoflow Showcase.NF_Target (name = 'hello');
  return $r;
}
/
