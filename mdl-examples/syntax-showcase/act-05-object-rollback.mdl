-- ============================================================
-- SHOWCASE: Rollback Activity
-- Mendix doc: /refguide/rollback-object/
-- MDL grammar rule: rollbackStatement
-- ============================================================

create module Showcase;

-- [ACT-ROLLBACK-01]
create microflow Showcase.Act_Rollback_01 ($order: Showcase.Order)
returns Nothing
{
  rollback $order;
}
/

-- [ACT-ROLLBACK-02] rollback + REFRESH
create microflow Showcase.Act_Rollback_02 ($order: Showcase.Order)
returns Nothing
{
  rollback $order refresh;
}
/
