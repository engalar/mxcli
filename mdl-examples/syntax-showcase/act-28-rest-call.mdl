-- ============================================================
-- SHOWCASE: REST Call Activity
-- Mendix doc: /refguide/rest-request/
-- MDL grammar rule: restCallStatement
-- Syntax: [$Var =] REST CALL <method> <url> ... RETURNS string|response|none
-- ============================================================

create module Showcase;

-- [ACT-REST-01] 基本 GET，返回字符串
create microflow Showcase.Act_Rest_01 ()
returns string as $r
{
  declare $r: string = empty;
  $r = rest call get 'https://api.example.com/orders' returns string;
  return $r;
}
/

-- [ACT-REST-02] POST + header + body 模板，忽略响应
create microflow Showcase.Act_Rest_02 ($payload: string)
returns Nothing
{
  rest call post 'https://api.example.com/orders'
    header 'Content-Type' = 'application/json'
    body $payload
    returns none;
}
/
