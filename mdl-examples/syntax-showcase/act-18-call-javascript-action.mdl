-- ============================================================
-- SHOWCASE: Call JavaScript Action
-- Mendix doc: /refguide/javascript-action-call/
-- MDL grammar rule: callJavaScriptActionStatement
-- ============================================================

create module Showcase;

-- [ACT-JS-01] call javascript action（nanoflow context）
create nanoflow Showcase.Act_JsCall_01 ($text: string)
returns string as $r
{
  declare $r: string = empty;
  $r = call javascript action Showcase.JSA_Trim (Input = $text);
  return $r;
}
/
