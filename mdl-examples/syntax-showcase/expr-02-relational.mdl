-- ============================================================
-- SHOWCASE: Relational Operators
-- Mendix doc: /refguide/relational-expressions/
-- MDL grammar rule: expression (relationalExpression)
-- ============================================================

create module Showcase;

-- [EXPR-REL-01] 整数比较
create microflow Showcase.Expr_Rel_01 ($a: integer, $b: integer)
returns boolean as $r
{
  declare $r: boolean = $a < $b;
  return $r;
}
/

-- [EXPR-REL-02] 全运算符覆盖
create microflow Showcase.Expr_Rel_02 ($x: integer)
returns string as $r
{
  declare $r: string = 'none';
  if $x = 0 then
    set $r = 'eq';
  end if;
  if $x != 1 then
    set $r = 'ne';
  end if;
  if $x <= 2 then
    set $r = 'le';
  end if;
  if $x >= 3 then
    set $r = 'ge';
  end if;
  return $r;
}
/
