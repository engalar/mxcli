-- ============================================================
-- SHOWCASE: Retrieve from Database
-- Mendix doc: /refguide/retrieve/
-- MDL grammar rule: retrieveStatement (database source = Module.Entity)
-- ============================================================

create module Showcase;

-- [ACT-RETR-DB-01] 基本 retrieve
create microflow Showcase.Act_RetrDb_01 ()
returns list of Showcase.Order as $r
{
  declare $r: list of Showcase.Order = empty;
  retrieve $r from Showcase.Order;
  return $r;
}
/

-- [ACT-RETR-DB-02] where + sort + limit + offset
create microflow Showcase.Act_RetrDb_02 ($status: Showcase.OrderStatus)
returns list of Showcase.Order as $r
{
  declare $r: list of Showcase.Order = empty;
  retrieve $r from Showcase.Order
    where [Status = $status]
    sort by OrderDate desc
    limit 10
    offset 0;
  return $r;
}
/

-- [ACT-RETR-DB-03] single object (limit 1)
create microflow Showcase.Act_RetrDb_03 ($num: string)
returns Showcase.Order as $r
{
  declare $r: Showcase.Order = empty;
  retrieve $r from Showcase.Order
    where [OrderNumber = $num]
    limit 1;
  return $r;
}
/
