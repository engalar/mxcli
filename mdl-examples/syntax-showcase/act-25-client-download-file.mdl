-- ============================================================
-- SHOWCASE: Download File Activity
-- Mendix doc: /refguide/download-file/
-- MDL grammar rule: downloadFileStatement
-- ============================================================

create module Showcase;

-- [ACT-DL-01] download file
create microflow Showcase.Act_Download_01 ($file: System.FileDocument)
returns Nothing
{
  download file $file;
}
/
