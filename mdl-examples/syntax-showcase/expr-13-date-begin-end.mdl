-- ============================================================
-- SHOWCASE: Begin/End of Date Functions
-- Mendix doc: /refguide/begin-of-date-function-calls/
-- MDL grammar rule: functionCallExpression
-- ============================================================

create module Showcase;

-- [EXPR-DATE-BEGIN-01] beginOfDay, beginOfWeek, beginOfMonth, beginOfYear
create microflow Showcase.Expr_DateBegin_01 ($d: datetime)
returns datetime as $r
begin
  declare $r: datetime = beginOfDay($d);
  return $r;
end;
/

-- [EXPR-DATE-END-01] endOfDay, endOfWeek, endOfMonth, endOfYear
create microflow Showcase.Expr_DateEnd_01 ($d: datetime)
returns datetime as $r
begin
  declare $r: datetime = endOfDay($d);
  return $r;
end;
/

-- [EXPR-DATE-BEGIN-02] beginOfWeek, beginOfMonth, beginOfYear (with datetime parameter)
create microflow Showcase.Expr_DateBegin_02 ($d: datetime)
returns Nothing
begin
  declare $d1: datetime = beginOfWeek($d);
  declare $d2: datetime = beginOfMonth($d);
  declare $d3: datetime = beginOfYear($d);
end;
/

-- [EXPR-DATE-END-02] endOfWeek, endOfMonth, endOfYear (with datetime parameter)
create microflow Showcase.Expr_DateEnd_02 ($d: datetime)
returns Nothing
begin
  declare $d1: datetime = endOfWeek($d);
  declare $d2: datetime = endOfMonth($d);
  declare $d3: datetime = endOfYear($d);
end;
/
