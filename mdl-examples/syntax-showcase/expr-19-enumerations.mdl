-- ============================================================
-- SHOWCASE: Enumeration Expressions
-- Mendix doc: /refguide/enumerations-in-expressions/
-- MDL grammar rule: enumerationValue, functionCallExpression (getCaption)
-- ============================================================

create module Showcase;

-- [EXPR-ENUM-01] 枚举值比较
create microflow Showcase.Expr_Enum_01 ($order: Showcase.Order)
returns boolean as $r
{
  declare $r: boolean = $order/Status = Showcase.OrderStatus.Active;
  return $r;
}
/

-- [EXPR-ENUM-02] getCaption
create microflow Showcase.Expr_Enum_02 ($order: Showcase.Order)
returns string as $r
{
  declare $r: string = getCaption($order/Status);
  return $r;
}
/
