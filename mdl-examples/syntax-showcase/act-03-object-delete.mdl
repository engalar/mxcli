-- ============================================================
-- SHOWCASE: Delete Object Activity
-- Mendix doc: /refguide/delete-object/
-- MDL grammar rule: deleteObjectStatement
-- ============================================================

create module Showcase;

-- [ACT-DELETE-01] 基本 delete
create microflow Showcase.Act_Delete_01 ($order: Showcase.Order)
returns Nothing
{
  delete $order;
}
/

-- [ACT-DELETE-02] delete + on error continue
create microflow Showcase.Act_Delete_02 ($order: Showcase.Order)
returns Nothing
{
  delete $order on error continue;
}
/
