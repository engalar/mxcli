-- ============================================================
-- SHOWCASE: Commit Activity
-- Mendix doc: /refguide/committing-objects/
-- MDL grammar rule: commitStatement
-- ============================================================

create module Showcase;

-- [ACT-COMMIT-01] 基本 commit
create microflow Showcase.Act_Commit_01 ($order: Showcase.Order)
returns Nothing
{
  commit $order;
}
/

-- [ACT-COMMIT-02] commit WITH EVENTS
create microflow Showcase.Act_Commit_02 ($order: Showcase.Order)
returns Nothing
{
  commit $order with events;
}
/

-- [ACT-COMMIT-03] commit REFRESH
create microflow Showcase.Act_Commit_03 ($order: Showcase.Order)
returns Nothing
{
  commit $order refresh;
}
/
