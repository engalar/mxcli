-- ============================================================
-- SHOWCASE: Retrieve from Association
-- Mendix doc: /refguide/retrieve/
-- MDL grammar rule: retrieveStatement (association)
-- ============================================================

create module Showcase;

-- [ACT-RETR-ASSOC-01] retrieve from association
create microflow Showcase.Act_RetrAssoc_01 ($order: Showcase.Order)
returns Showcase.Product as $r
{
  declare $r: Showcase.Product = empty;
  retrieve $r from $order/Showcase.Order_Product;
  return $r;
}
/
