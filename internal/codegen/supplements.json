        "properties": [
          {"name": "path", "kind": "Primitive", "primitive_type": "String"},
          {"name": "httpMethod", "kind": "Primitive", "primitive_type": "String"},
          {"name": "deprecated", "kind": "Primitive", "primitive_type": "Boolean"},
