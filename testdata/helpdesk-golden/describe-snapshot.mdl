create or modify microflow HD.ACT_Workflow_Notify (
  $Workflow: System.Workflow
)
begin
  notify workflow $Workflow activity HD.WF_TicketEscalation.WaitForManagerAvailable;
  return;
end;

grant execute on microflow HD.ACT_Workflow_Notify to User, ManagerRole;
/
-- Workflow: HD.WF_SUB_ManagerReview

create workflow HD.WF_SUB_ManagerReview
  parameter $WorkflowContext: HD.EscalationRequest
  display 'Manager Review'
  overview page HD.EscalationWorkflow_Overview

begin
  user task UT_PrimaryReview 'Primary Review'
    page HD.EscalationReview_Form
    targeting microflow HD.WFA_GetManagerAssignees
    description 'Review escalation request and decide: Approve or escalate to board'
    outcomes
      'Approve' {
        call microflow HD.WFS_Approve with (EscalationRequest = '$WorkflowContext') -- WFS_Approve
          outcomes
            default -> { };

      }
      'Escalate' {
        multi user task UT_SeniorReview 'Senior Board Review'
          page HD.EscalationReview_Form
          targeting microflow HD.WFA_GetManagerAssignees
          outcomes
            'Approve' {
              call microflow HD.WFS_Approve with (EscalationRequest = '$WorkflowContext') -- WFS_Approve
                outcomes
                  default -> { };

            }
            'Reject' {
              call microflow HD.WFS_Reject with (EscalationRequest = '$WorkflowContext') -- WFS_Reject
                outcomes
                  default -> { };

            };

      };

end workflow
/
-- Workflow: HD.WF_TicketEscalation

create workflow HD.WF_TicketEscalation
  parameter $WorkflowContext: HD.EscalationRequest
  display 'Ticket Escalation'
  overview page HD.EscalationWorkflow_Overview

begin
  call microflow HD.WFS_Escalation_Initialize with (EscalationRequest = '$WorkflowContext') -- WFS_Escalation_Initialize
    outcomes
      default -> { };

  decision '$WorkflowContext/Reason = empty and $WorkflowInstance/State = System.WorkflowState.Completed ' -- Decision
    outcomes
      true -> {
        call microflow HD.WFS_AutoReject with (EscalationRequest = '$WorkflowContext') -- WFS_AutoReject
          outcomes
            default -> { };

      }
      false -> {
        wait for notification; -- WaitForManagerAvailable

        call workflow HD.WF_SUB_ManagerReview comment 'WF_SUB_ManagerReview' with (WorkflowContext = '$WorkflowContext');

        parallel split -- Parallel split
          path 1 {
            call microflow HD.WFS_UpdateTicketPriority with (EscalationRequest = '$WorkflowContext') -- WFS_UpdateTicketPriority
              outcomes
                default -> { };

          }
          path 2 {
            call microflow HD.WFS_NotifyAgent with (EscalationRequest = '$WorkflowContext') -- WFS_NotifyAgent
              outcomes
                default -> { };

          };

      };

end workflow
/
create or modify page KB.Article_Overview (
  title: 'Knowledge Base',
  layout: Atlas_Core.Atlas_Default,
  folder: 'Article'
) {
  layoutgrid lgMain {
    row row1 {
      column col1 (desktopwidth: 12) {
        datagrid dgArticles (datasource: database from KB.Article) {
          -- Context: $currentObject (KB.Article), $dgArticles (selection)
          column colTitle (attribute: Title, caption: 'Title')
          column colStatus (attribute: Status, caption: 'Status')
        }
        actionbutton btnNewArticle (caption: 'New Article')
      }
    }
  }
}

grant view on page KB.Article_Overview to KB.User, KB.Reader, KB.Contributor, KB.Admin;
create or modify page KB.Article_Detail (
  title: 'Article',
  layout: Atlas_Core.Atlas_Default,
  folder: 'Article',
  params: { $Article: KB.Article }
) {
  layoutgrid lgMain {
    row row1 {
      column col1 (desktopwidth: 9) {
        dataview dvArticle (datasource: $Article) {
          -- Context: $currentObject (Article)
          dynamictext txtTitle (content: 'Article Title', rendermode: H1)
          dynamictext txtContent_ (content: 'Article Body Text')
        }
      }
      column col2 (desktopwidth: 3) {
        datagrid dgRatings (datasource: database from KB.ArticleRating) {
          -- Context: $currentObject (KB.ArticleRating), $dgRatings (selection)
          column colScore (attribute: Score, caption: 'Score')
          column colComment (attribute: Comment, caption: 'Comment')
        }
      }
    }
  }
}

