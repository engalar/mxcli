)
begin
  retrieve $Tickets from HD.Ticket
    limit 100;
  return $Tickets;
end;

grant execute on nanoflow HD.NF_TicketSearch_Apply to User, CustomerRole, AgentRole, ManagerRole;
/
create or modify nanoflow HD.NF_Priority_GetLabel (
  $PriorityStr: String
)
returns String
begin
  declare $CSSClass String = 'badge-default';
  if $PriorityStr = 'Critical' then
    set $CSSClass = 'badge-danger'
;
  else
    if $PriorityStr = 'High' then
      set $CSSClass = 'badge-warning'
;
    else
      if $PriorityStr = 'Normal' then
        set $CSSClass = 'badge-info'
;
      end if;
    end if;
  end if;
  return $CSSClass;
end;

grant execute on nanoflow HD.NF_Priority_GetLabel to User, CustomerRole, AgentRole, ManagerRole;
/
