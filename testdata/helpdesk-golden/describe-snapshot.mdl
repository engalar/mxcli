@Position(100, 100)
create or modify persistent entity KB.Category (
  Name: String(200) not null,
  Description: String(500)
);

grant KB.Reader on KB.Category (read *);

grant KB.Contributor on KB.Category (create, read *, write *);

grant KB.Admin on KB.Category (create, delete, read *, write *);
/
@Position(250, 100)
create or modify persistent entity KB.Tag (
  Name: String(100) not null unique
);

grant KB.Reader on KB.Tag (read *);

grant KB.Contributor on KB.Tag (create, read *, write *);

grant KB.Admin on KB.Tag (create, delete, read *, write *);
/
@Position(400, 100)
create or modify persistent entity KB.Article (
  Title: String(500) not null,
  Content: String(unlimited),
  Status: Enumeration(KB.ArticleStatus) default KB.ArticleStatus.Draft,
  PublishedAt: DateTime,
  ViewCount: Integer default 0
)
index (Status)
index (PublishedAt);

grant KB.Reader on KB.Article (read *) where '[Status = ''Published'']';

grant KB.Contributor on KB.Article (create, delete, read *, write *);

grant KB.Admin on KB.Article (create, delete, read *, write *);
/
@Position(550, 100)
create or modify persistent entity KB.ArticleTag (
);

grant KB.Reader on KB.ArticleTag (read *);

grant KB.Contributor on KB.ArticleTag (create, delete, read *, write *);

grant KB.Admin on KB.ArticleTag (create, delete, read *, write *);
