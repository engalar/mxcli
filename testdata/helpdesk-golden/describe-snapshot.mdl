create or modify enumeration KB.ArticleStatus (
  Draft 'Draft',
  Published 'Published',
  Archived 'Archived'
);
/
create or modify enumeration HD.TicketStatus (
  Draft 'Draft',
  Open 'Open',
  InProgress 'In Progress',
  Resolved 'Resolved',
  Closed 'Closed'
);
/
create or modify enumeration HD.TicketPriority (
  Low 'Low',
  Normal 'Normal',
  High 'High',
  Critical 'Critical'
);
/
create or modify microflow KB.ACT_Article_Publish (
  $Article: KB.Article
)
returns Boolean as $Success
begin
  if $Article/Content = '' or $Article/Content = empty then
    validation feedback $Article/Content message 'Content cannot be empty before publishing.';
    return false;
  else
    change $Article (Status = KB.ArticleStatus.Published
, PublishedAt = [%CurrentDateTime%]
);
    commit $Article;
    return true;
  end if;
end;

grant execute on microflow KB.ACT_Article_Publish to User, Contributor, Admin;
/
create or modify microflow KB.ACT_Article_Archive (
  $Article: KB.Article
)
returns Boolean as $Success
begin
  change $Article (Status = KB.ArticleStatus.Archived
);
  commit $Article;
  return true;
end;

grant execute on microflow KB.ACT_Article_Archive to User, Contributor, Admin;
/
create or modify microflow KB.SUB_Article_TruncateContent (
  $Article: KB.Article
)
returns String as $Preview
begin
  declare $Preview String = $Article/Content;
  return $Preview;
end;

grant execute on microflow KB.SUB_Article_TruncateContent to User;
/
create or modify nanoflow KB.NF_Article_FormatPreview (
  $Article: KB.Article
)
returns String
begin
  $Preview = call microflow KB.SUB_Article_TruncateContent(Article = $Article);
  return $Preview;
end;

grant execute on nanoflow KB.NF_Article_FormatPreview to User, Reader, Contributor, Admin;
/
create or modify microflow HD.ACT_Ticket_Submit (
  $Ticket: HD.Ticket
)
returns Boolean as $Success
begin
  if $Ticket/Subject = '' then
    validation feedback $Ticket/Subject message 'Subject is required';
    return false;
  else
    if $Ticket/Priority = HD.TicketPriority.Critical then
      change $Ticket (Status = HD.TicketStatus.Open
, SLADueAt = addHours([%CurrentDateTime%], @HD.SLA_CRITICAL_HOURS)
);
    else
      if $Ticket/Priority = HD.TicketPriority.High then
        change $Ticket (Status = HD.TicketStatus.Open
, SLADueAt = addHours([%CurrentDateTime%], @HD.SLA_HIGH_HOURS)
);
      else
        change $Ticket (Status = HD.TicketStatus.Open
, SLADueAt = addHours([%CurrentDateTime%], 24)
);
      end if;
    end if;
    commit $Ticket;
    return true;
  end if;
end;

grant execute on microflow HD.ACT_Ticket_Submit to User, CustomerRole, AgentRole, ManagerRole;
/
create or modify microflow HD.ACT_Ticket_Assign (
  $Ticket: HD.Ticket,
  $Agent: HD.Agent
)
returns Boolean as $Success
begin
  if $Ticket/Status != HD.TicketStatus.Open then
    show message 'Only Open tickets can be assigned.' type warning;
    return false;
  else
    change $Ticket (Status = HD.TicketStatus.InProgress
, HD.Ticket_Agent = $Agent
);
    commit $Ticket;
    return true;
  end if;
end;

grant execute on microflow HD.ACT_Ticket_Assign to User, AgentRole, ManagerRole;
/
create or modify microflow HD.ACT_Ticket_Resolve (
  $Ticket: HD.Ticket
)
returns Boolean as $Success
begin
  if $Ticket/Status != HD.TicketStatus.InProgress then
    return false;
  else
    declare $Now DateTime = [%CurrentDateTime%];
    declare $IsOver Boolean = $Now > $Ticket/SLADueAt and $Ticket/SLADueAt != empty;
    change $Ticket (Status = HD.TicketStatus.Resolved
, ResolvedAt = $Now
, IsOverSLA = $IsOver
);
    commit $Ticket;
    return true;
  end if;
end;

grant execute on microflow HD.ACT_Ticket_Resolve to User, AgentRole, ManagerRole;
/
create or modify microflow HD.ACT_Ticket_Reopen (
  $Ticket: HD.Ticket
)
returns Boolean as $Success
begin
  if $Ticket/Status != HD.TicketStatus.Resolved and $Ticket/Status != HD.TicketStatus.Closed then
    return false;
  else
    change $Ticket (Status = HD.TicketStatus.Open
, ResolvedAt = empty);
    commit $Ticket;
    return true;
  end if;
end;

grant execute on microflow HD.ACT_Ticket_Reopen to User, AgentRole, ManagerRole;
/
create or modify microflow HD.ACT_Ticket_Close (
  $Ticket: HD.Ticket
)
returns Boolean as $Success
begin
  if $Ticket/Status != HD.TicketStatus.Resolved then
    return false;
  else
    change $Ticket (Status = HD.TicketStatus.Closed
);
    commit $Ticket;
    return true;
  end if;
end;

grant execute on microflow HD.ACT_Ticket_Close to User, AgentRole, ManagerRole;
/
create or modify microflow HD.ACT_Ticket_SafeCommit (
  $Ticket: HD.Ticket
)
returns Boolean as $Success
begin
  declare $Success Boolean = false;
  commit $Ticket;
  set $Success = true
;
  return $Success;
end;

grant execute on microflow HD.ACT_Ticket_SafeCommit to User;
/
create or modify microflow HD.ACT_Ticket_MarkCommentsRead (
  $Ticket: HD.Ticket
)
begin
  retrieve $Comments from HD.TicketComment
    where HD.TicketComment_Ticket/HD.Ticket = $Ticket and IsInternal = true
    limit 100;
  loop $Comment in $Comments
  begin
    commit $Comment;
  end loop;
  return;
end;

grant execute on microflow HD.ACT_Ticket_MarkCommentsRead to User;
/
create or modify microflow HD.ACT_EscalationRequest_Cleanup (
  $Ticket: HD.Ticket
)
begin
  retrieve $Requests from HD.EscalationRequest
    where HD.EscalationRequest_Ticket/HD.Ticket = $Ticket
    limit 50;
  loop $Req in $Requests
  begin
    delete $Req;
  end loop;
  return;
end;

grant execute on microflow HD.ACT_EscalationRequest_Cleanup to User, AgentRole, ManagerRole;
/
create or modify microflow HD.DS_OverdueTicketCount ()
returns Integer as $Count
begin
  retrieve $Overdue from HD.Ticket
    where IsOverSLA = true
    limit 0;
  $Count = count($Overdue);
  return $Count;
end;

grant execute on microflow HD.DS_OverdueTicketCount to User;
/
create or modify nanoflow HD.NF_Ticket_QuickCreate (
  $Customer: HD.Customer,
  $Subject: String
)
begin
  $Ticket = create HD.Ticket (Subject = $Subject
, Status = HD.TicketStatus.Draft
, Priority = HD.TicketPriority.Normal
, Ticket_Customer = $Customer
);
  commit $Ticket;
  return $Ticket;
end;

grant execute on nanoflow HD.NF_Ticket_QuickCreate to User, CustomerRole, AgentRole;
/
create or modify nanoflow HD.NF_TicketSearch_Apply (
