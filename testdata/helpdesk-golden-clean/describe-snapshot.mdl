create or modify page MyFirstModule.Home_Web (title: 'Homepage', layout: Atlas_Core.Atlas_TopBar) {
  layoutgrid layoutGrid3 (designproperties: ['Row gap': 'Large']) {
    row row1 {
      column col1 (desktopwidth: AutoFill) {
        dynamictext text1 (content: 'Tekst', rendermode: H1)
      }
    }
    row row2 {
      column col1 (desktopwidth: AutoFill) {
        layoutgrid layoutGrid1 {
          row row1 {
            column col1 (desktopwidth: AutoFill) {
              image image8 (widthunit: pixels, width: 36, heightunit: pixels, height: 36)
            }
            column col2 (desktopwidth: AutoFill) {
              dynamictext text23 (content: 'Define and organize your data', rendermode: H2)
            }
          }
          row row2 {
            column col1 (desktopwidth: AutoFill) {
              dynamictext text3 (content: 'Tekst', designproperties: ['Color': 'Detail color'])
            }
          }
          row row3 {
            column col1 (desktopwidth: AutoFill) {
              dynamictext text21 (content: 'Domain model', rendermode: H4)
              image image7
              dynamictext text22 (
                content: 'A well-structured Domain Model forms the foundation for the components and pages you''ll build next.',
                rendermode: Paragraph,
                designproperties: ['Color': 'Detail color']
              )
              actionbutton actionButton4 (caption: 'Learn more')
            }
          }
        }
      }
    }
    row row3 {
      column col1 (desktopwidth: AutoFill) {
        layoutgrid layoutGrid5 {
          row row1 {
            column col1 (desktopwidth: AutoFill) {
              image image13 (widthunit: pixels, width: 36, heightunit: pixels, height: 36)
            }
            column col2 (desktopwidth: AutoFill) {
              dynamictext text31 (content: 'Add and connect widgets to your page', rendermode: H2)
            }
          }
          row row2 {
            column col1 (desktopwidth: AutoFill) {
              dynamictext text5 (content: 'Tekst', rendermode: Paragraph, designproperties: ['Color': 'Detail color'])
              dynamictext text2 (
                content: 'Here are a few commonly used widgets:',
                designproperties: ['Color': 'Detail color']
              )
            }
          }
          row row3 {
            column col1 (desktopwidth: AutoFill) {
              dynamictext text32 (content: 'Combo box', rendermode: H4)
              image image14
              dynamictext text33 (
                content: 'Let users select one or multiple options from a static list, an enumeration, or dynamic data - ideal for input forms.',
                rendermode: Paragraph,
                designproperties: ['Color': 'Detail color']
              )
              actionbutton actionButton8 (caption: 'Learn more')
            }
            column col2 (desktopwidth: AutoFill) {
              dynamictext text34 (content: 'Data grid 2', rendermode: H4)
              image image15
              dynamictext text35 (
                content: 'A powerful, modern table for displaying data with flexible layouts, sorting, filtering, and styling options.',
                rendermode: Paragraph,
                designproperties: ['Color': 'Detail color']
              )
              actionbutton actionButton9 (caption: 'Learn more')
            }
            column col3 (desktopwidth: AutoFill) {
              dynamictext text36 (content: 'Gallery', rendermode: H4)
              image image16
              dynamictext text37 (
                content: 'Present a collection of items or  images in a sleep, responsive grid. Great for product overviews, image galleries, or lists.',
                rendermode: Paragraph,
                designproperties: ['Color': 'Detail color']
              )
              actionbutton actionButton10 (caption: 'Learn more')
            }
          }
        }
      }
    }
    row row4 {
      column col1 (desktopwidth: AutoFill) {
        layoutgrid layoutGrid2 {
          row row1 {
            column col1 (desktopwidth: AutoFill) {
              image image9 (widthunit: pixels, width: 36, heightunit: pixels, height: 36)
            }
            column col2 (desktopwidth: AutoFill) {
              dynamictext text24 (content: 'Add logic with Microflows, Nanoflows, and Workflows', rendermode: H2)
            }
          }
          row row2 {
            column col1 (desktopwidth: AutoFill) {
              dynamictext text4 (content: 'Tekst', designproperties: ['Color': 'Detail color'])
            }
          }
          row row3 {
            column col1 (desktopwidth: AutoFill) {
              layoutgrid layoutGrid4 {
                row row1 {
                  column col1 (desktopwidth: AutoFill) {
                    image image20 (widthunit: pixels, width: 48)
                  }
                  column col2 (desktopwidth: AutoFill) {
                    dynamictext text45 (content: 'Microflows', rendermode: H4)
                  }
                }
              }
              dynamictext text46 (
                content: 'Server-side logic used for data processing, validations, integrations, or any action that requires access to the database',
                rendermode: Paragraph,
                designproperties: ['Color': 'Detail color']
              )
              actionbutton actionButton13 (caption: 'Learn more')
            }
            column col2 (desktopwidth: AutoFill) {
              layoutgrid layoutGrid6 {
                row row1 {
                  column col1 (desktopwidth: AutoFill) {
                    image image11 (widthunit: pixels, width: 48)
                  }
                  column col2 (desktopwidth: AutoFill) {
                    dynamictext text47 (content: 'Nanoflows', rendermode: H4)
                  }
                }
              }
              dynamictext text28 (
                content: 'Client-side logic for fast, lightweight actions like toggling visibility, showing messages, or offline behavior on mobile.',
                rendermode: Paragraph,
                designproperties: ['Color': 'Detail color']
              )
              actionbutton actionButton6 (caption: 'Learn more')
            }
            column col3 (desktopwidth: AutoFill) {
              layoutgrid layoutGrid7 {
                row row1 {
                  column col1 (desktopwidth: AutoFill) {
                    image image18 (widthunit: pixels, width: 48)
                  }
                  column col2 (desktopwidth: AutoFill) {
                    dynamictext text48 (content: 'Workflows', rendermode: H4)
                  }
                }
              }
              dynamictext text30 (
                content: 'Ideal for modeling long-running, human-centric processes like approvals or reviews. Design multistep flows that include user tasks, decisions, and automated steps.',
                rendermode: Paragraph,
                designproperties: ['Color': 'Detail color']
              )
              actionbutton actionButton11 (caption: 'Learn more')
            }
          }
        }
      }
    }
  }
}
create or modify microflow MyFirstModule.MyFirstLogic ()
begin
  return;
  @annotation 'Microflows are used to define server logic in your app.\r\n\r\n- For client logic you can use Nanoflows\r\n- For business process logic you can use Workflows\r\n\r\nDocumentation: https://docs.mendix.com/refguide/application-logic'
end;
/
