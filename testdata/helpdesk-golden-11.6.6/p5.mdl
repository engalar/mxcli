-- Step 3: Apply zh_CN translations.
-- SET takes comma-separated path = 'text' pairs.
-- Enum captions use path format: <ValueName>.caption
translate enumeration HD.TicketStatus in zh_CN
  set Draft.caption      = '草稿',
      Open.caption       = '待处理',
      InProgress.caption = '处理中',
      Resolved.caption   = '已解决',
      Closed.caption     = '已关闭';

translate enumeration HD.TicketPriority in zh_CN
  set Low.caption      = '低',
      Normal.caption   = '普通',
      High.caption     = '高',
      Critical.caption = '紧急';

-- Page translation: "title" is a special bare path for the page title bar.
-- Widget-level paths (<WidgetName>.<property>) require the widget's BSON to
-- carry the matching Texts$Text node. Run:
--   describe translations HD.Ticket_NewEdit in zh_CN
-- to discover which widget properties are actually translatable before writing
-- SET statements; the output includes a ready-to-paste TRANSLATE template.
translate page HD.Ticket_NewEdit in zh_CN
  set title = '新建/编辑工单';

translate enumeration KB.ArticleStatus in zh_CN
  set Draft.caption     = '草稿',
      Published.caption = '已发布',
      Archived.caption  = '已归档';

translate page HD.Ticket_Overview in zh_CN
  set title = '工单列表';

translate page KB.Article_Overview in zh_CN
  set title = '知识库';

translate page HD.Account_Overview in zh_CN
  set title = '账户管理';

translate navigation Responsive in zh_CN
  set 'My Tickets'.caption            = '我的工单',
      'Knowledge Base'.caption        = '知识库',
      'Ticket Management'.caption     = '工单管理',
      'Ticket Management'.'All Tickets'.caption    = '所有工单',
      'Ticket Management'.'Escalations'.caption     = '升级审批',
      'Ticket Management'.'Workflow Admin'.caption  = '工作流管理',
      'Account Management'.caption     = '账户管理',
      'Account Management'.'Accounts'.caption       = '账户总览',
      'Account Management'.'My Account'.caption     = '我的账户',
      'Account Management'.'Change Password'.caption = '修改密码',
      'Admin'.caption                  = '系统管理';

-- Step 4: Apply nl_NL translations (partial — checkCompleteness will flag the rest).
translate enumeration HD.TicketStatus in nl_NL
  set Draft.caption = 'Concept',
      Open.caption  = 'Open';

-- Step 5: 单个语言的删除 — fr_FR was never translated; drop removes the registration only.
alter settings language drop 'fr_FR';

-- Step 6: 整个语言的删除 — nl_NL had partial translations; drop removes both the
-- registration and all nl_NL Texts$Translation entries from the BSON.
alter settings language drop 'nl_NL';

-- Step 7: Final state — en_US (default) + zh_CN with translations.
show languages;

-- ============================================================================
-- End of i18n Demo
-- ============================================================================

-- ============================================================================
-- MARK: FieldTech — Module & Entities
-- ============================================================================
-- Business context: Agents dispatch on-site field technicians for tickets that
-- require a physical visit. FieldTechs work mobile / offline; results sync
-- back when connectivity is restored. The FT module introduces all MDL features
-- not yet covered by the KB + HD baseline.
-- ============================================================================

create module FT;

create or modify enumeration FT.DispatchStatus (
  Pending   'Pending',
  EnRoute   'En Route',
  OnSite    'On Site',
  Completed 'Completed',
  Cancelled 'Cancelled'
);

-- FT.FieldTech: technician profile. system members (owner) links each record
-- to the Mendix user who created it — used in row-level security XPath.
create or modify persistent entity FT.FieldTech (
  Name:        string(200) not null,
  Phone:        string(50),
  Region:       string(100),
  IsAvailable:  boolean default true
)
system members (owner);

-- FT.DispatchOrder: one order per site visit. Multi-column index on
-- (Status, DispatchedAt) demonstrates the multi-column index syntax.
create or modify persistent entity FT.DispatchOrder (
  DispatchedAt: datetime,
  CompletedAt:  datetime,
  SiteNotes:    string,
  Status:       FT.DispatchStatus default Pending
)
index (Status)
index (Status, DispatchedAt);

-- delete_behavior CASCADE: when a DispatchOrder is removed, references are
-- deleted along with it. FT.DispatchOrder is the FROM entity (the FK owner);
-- delete_behavior governs what happens to this association on FROM-side delete.
create or modify association FT.DispatchOrder_Ticket
  from FT.DispatchOrder to HD.Ticket
  type reference
  owner default
  delete_behavior CASCADE;

-- delete_behavior PREVENT: deleting is blocked while the association is in use.
-- FT.DispatchOrder is the FROM entity; PREVENT guards the link to FieldTech.
create or modify association FT.DispatchOrder_FieldTech
  from FT.DispatchOrder to FT.FieldTech
  type reference
  owner default
  delete_behavior PREVENT;

-- FT.CheckInRecord: non-persistent GPS snapshot created offline, synced later.
create or modify non-persistent entity FT.CheckInRecord (
  Latitude:    decimal,
  Longitude:   decimal,
  CheckedInAt: datetime
);

create or modify association FT.CheckInRecord_DispatchOrder
  from FT.CheckInRecord to FT.DispatchOrder
  type reference
  owner default;

-- FT.WorkOrderImport: non-persistent webhook buffer for JSON import.
-- ScheduledAt is dateTime to match the ISO-8601 scheduledAt field in the
-- WorkOrderPayload JSON structure (import mapping enforces type alignment).
create or modify non-persistent entity FT.WorkOrderImport (
  RawPayload:   string,
  TicketRef:    string(200),
  TechName:     string(200),
  ScheduledAt:  datetime
);

-- FT.DispatchStatus and FT.SLADashboard zh_CN translations:
-- (placed after FT entities so enumeration and page exist)
translate enumeration FT.DispatchStatus in zh_CN
  set Pending.caption   = '待派遣',
      EnRoute.caption   = '前往中',
      OnSite.caption    = '到场',
      Completed.caption = '已完成',
      Cancelled.caption = '已取消';

-- ============================================================================
-- MARK: FieldTech — OQL Analytics
-- ============================================================================
-- Two view entities for the SLA dashboard page (FT.SLADashboard).
-- Demonstrates: CREATE VIEW ENTITY, LEFT OUTER JOIN, count(t.ID), avg(),
-- explicit AS aliases (required — Mendix maps aliases to entity attributes),
-- no ORDER BY / LIMIT (UI handles sorting).
-- ============================================================================

-- SLA compliance per agent: total tickets and overdue count.
-- IsOverSLA is boolean; count() on a boolean column counts non-null true values.
create or modify view entity FT.TicketSLAStats (
  AgentName:    string(200),
  TotalTickets: integer,
  OverSLACount: integer
) as (
  select
    a.Name             as AgentName,
    count(t.ID)        as TotalTickets,
    count(t.IsOverSLA) as OverSLACount
  from HD.Ticket as t
  left outer join t/HD.Ticket_Agent/HD.Agent as a
  group by a.Name
);

-- Dispatch completion summary per FieldTech.
-- avg() on integer (DATEPART result) returns decimal — declared as decimal.
-- FT.DispatchSummary: simplified to avoid CE6770 (View Entity out of sync
-- with OQL Query). The avg(datepart(HOUR, ...) - datepart(HOUR, ...)) arithmetic
-- inside avg() is not supported. Simplified to count-only query.
create or modify view entity FT.DispatchSummary (
  TechName:   string(200),
  OrderCount: integer
) as (
  select
    ft.Name      as TechName,
    count(d.ID)  as OrderCount
  from FT.DispatchOrder as d
  left outer join d/FT.DispatchOrder_FieldTech/FT.FieldTech as ft
  where d.Status = 'Completed'
  group by ft.Name
);

-- ============================================================================
-- MARK: FieldTech — Microflows
-- ============================================================================

-- ACT_Dispatch_Assign: Agent assigns a FieldTech to a Ticket.
-- New activity: CREATE LIST — builds a list of candidate FT.FieldTech objects
-- available for dispatch (IsAvailable = true). LIST is then filtered by Region.
-- In production use retrieve-then-filter; here CREATE LIST demonstrates syntax.
create or modify microflow FT.ACT_Dispatch_Assign
  ($Ticket: HD.Ticket, $FieldTech: FT.FieldTech)
  returns boolean as $Success
  folder 'Dispatch'
{
  -- CREATE LIST activity: instantiates an empty typed list variable.
  -- Use case: accumulate objects before a bulk commit or decision.
  $Candidates = create list of FT.FieldTech;

  if $FieldTech/IsAvailable = false {
    show message 'Selected technician is not available.' type warning;
    return false;
  }
  $Order = create FT.DispatchOrder (
    Status       = FT.DispatchStatus.Pending,
    DispatchedAt = '[%CurrentDateTime%]',
    FT.DispatchOrder_Ticket    = $Ticket,
    FT.DispatchOrder_FieldTech = $FieldTech
  );
  commit $Order;
  change $FieldTech (IsAvailable = false);
  commit $FieldTech;
  return true;
}
/

-- ACT_Dispatch_Open: called from Ticket_Detail ALTER PAGE button.
-- Creates a draft DispatchOrder linked to the Ticket, then shows the detail page.
create or modify microflow FT.ACT_Dispatch_Open
  ($Ticket: HD.Ticket)
  folder 'Dispatch'
{
  $Order = create FT.DispatchOrder (
    Status = FT.DispatchStatus.Pending,
    FT.DispatchOrder_Ticket = $Ticket
  );
  commit $Order;
  show page FT.DispatchOrder_Detail (DispatchOrder: $Order);
  return;
}
/

-- ACT_Dispatch_Complete: marks order Completed, sends SMS via REST, logs.
-- Demonstrates: send rest request (REST client operation call).
-- $latestHttpResponse/StatusCode reads the HTTP status after the call.
create or modify microflow FT.ACT_Dispatch_Complete
  ($Order: FT.DispatchOrder)
  returns boolean as $Success
  folder 'Dispatch'
{
  if $Order/Status = FT.DispatchStatus.Completed {
    return false;
  }
  change $Order (
    Status      = FT.DispatchStatus.Completed,
    CompletedAt = '[%CurrentDateTime%]'
  );
  commit $Order;
  -- Notify FieldTech via SMS gateway (REST client defined in MARK: REST).
  -- $latestHttpResponse is the System.HttpResponse object after the call.
  send rest request FT.SMSGateway.NotifyTech;
  declare $StatusCode: integer = $latestHttpResponse/StatusCode;
  log info 'SMS notification sent, HTTP status: ' + toString($StatusCode);
  return true;
}
/

-- ACT_WorkOrder_Import: parse JSON payload into FT.WorkOrderImport entity.
-- Demonstrates: import from mapping activity.
create or modify microflow FT.ACT_WorkOrder_Import
  ($JsonPayload: string)
  folder 'Dispatch'
{
  -- IMPORT FROM MAPPING syntax demonstrated via comment. The import mapping
  -- itself (FT.WorkOrderImport_Mapping) is now valid (CE0271 fixed — the JSON
  -- structure carries a parsed element tree). The `import from mapping` ACTIVITY
  -- has a separate executor gap: ImportMappingCall writes the mapping reference
  -- under the wrong BSON key ("ImportMapping" instead of "ReturnValueMapping")
  -- and omits required fields (Commit, ContentType, Range), producing CE0241.
  -- The pattern:
  --   $Imported = import from mapping FT.WorkOrderImport_Mapping($JsonPayload);
  $Order = create FT.DispatchOrder (
    Status     = FT.DispatchStatus.Pending,
    SiteNotes  = 'Imported from payload: ' + $JsonPayload
  );
  commit $Order;
  return;
}
/

-- ACT_FT_Initialize: AfterStartup hook — reset all technician availability flags.
-- Registered via ALTER SETTINGS MODEL in Task 9.
create or modify microflow FT.ACT_FT_Initialize
  ()
  returns boolean as $OK
  folder 'System'
{
  retrieve $Techs from FT.FieldTech limit 0;
  loop $Tech in $Techs {
    change $Tech (IsAvailable = true);
    commit $Tech;
  }
  log info 'FieldTech availability reset at startup.';
  return true;
}
/

-- DS_HealthCheck: HealthCheck microflow — Mendix requires string return type.
-- Returns "OK" when no pending orders; "DEGRADED: N pending" otherwise.
create or modify microflow FT.DS_HealthCheck
  ()
  returns string as $Status
  folder 'System'
{
  retrieve $Pending from FT.DispatchOrder
    where [Status = 'Pending']
    limit 0;
  $Count = COUNT($Pending);
  if $Count > 0 {
    return 'DEGRADED: ' + toString($Count) + ' pending dispatch orders';
  }
  return 'OK';
}
/

-- DS_MyDispatchOrders: retrieves DispatchOrders for the current FieldTech.
-- XPath: traverse DispatchOrder → FieldTech (FROM side), match System.owner.
-- reversed() demo: see DS_RelevantArticles below.
create or modify microflow FT.DS_MyDispatchOrders
  ()
  returns list of FT.DispatchOrder as $Orders
  folder 'Dispatch'
{
  retrieve $Orders from FT.DispatchOrder
    where [FT.DispatchOrder_FieldTech/FT.FieldTech/System.owner = '[%CurrentUser%]'
           and Status != 'Completed' and Status != 'Cancelled']
    sort by DispatchedAt asc
    limit 50;
  return $Orders;
}
/

-- DS_RelevantArticles: retrieve KB articles tagged 'fieldtech-relevant'.
-- Demonstrates reversed() XPath: KB.ArticleTag_Article runs FROM KB.ArticleTag TO KB.Article.
-- On KB.Article we reverse: [KB.ArticleTag_Article[reversed()]/KB.ArticleTag/...]
-- reads "articles where at least one ArticleTag points back to this article and
-- the Tag name equals 'fieldtech-relevant'".
create or modify microflow FT.DS_RelevantArticles
  ()
  returns list of KB.Article as $Articles
  folder 'Dispatch'
{
  -- reversed() XPath demonstrated above in the comment; simplified here to avoid
  -- CE0161 (mxcli executor does not fully validate multi-hop reversed() paths).
  retrieve $Articles from KB.Article
    where [Status = 'Published']
    limit 20;
  return $Articles;
}
/

-- DS_CategoryChildren: list the direct child categories of a parent.
-- Demonstrates single-hop reversed() on a self-referencing association.
-- KB.Category_Parent goes FROM KB.Category TO KB.Category (self-reference);
-- reversed() walks the FK backwards to find children pointing at $ParentCategory.
-- Validated: mx check 0 errors on 11.6.6 and 11.10.0.
create or modify microflow FT.DS_CategoryChildren
  ($ParentCategory: KB.Category)
  returns list of KB.Category as $Children
  folder 'Dispatch'
{
  retrieve $Children from KB.Category
    where [KB.Category_Parent[reversed()] = $ParentCategory]
    limit 50;
  return $Children;
}
/

-- ============================================================================
-- MARK: FieldTech — Nanoflows (Offline)
-- ============================================================================
-- These nanoflows run on the FieldTech's mobile device (OfflineNative profile).
-- NanoflowCommons JS actions are available when the NanoflowCommons marketplace
-- module is installed.
--
-- NOTE on SYNCHRONIZE: Mendix native/offline apps use a SYNCHRONIZE activity to
-- push offline-committed objects to the server. SYNCHRONIZE is a planned MDL
-- feature but is NOT yet implemented in the current grammar — there is no
-- `synchronize` keyword. These nanoflows therefore rely on COMMIT (which queues
-- the change locally in offline context) plus a connectivity guard; the actual
-- server sync is performed by the Mendix offline runtime automatically. When
-- SYNCHRONIZE lands in MDL, add `synchronize $Object;` after the relevant commits.
-- ============================================================================

-- NF_FT_CheckIn: capture GPS on arrival at site.
-- New activity: CALL JAVASCRIPT ACTION (device GPS) + connectivity guard.
--
-- This nanoflow is PARAMETERLESS and is invoked from page actionbuttons WITHOUT
-- arguments — a workaround for an mxcli bug where a page actionbutton calling a
-- nanoflow *with parameters* writes an invalid parameter mapping that crashes
-- `mx check` (root cause fixed + CE0115 TODO in cmd_pages_builder_v3.go; the
-- microflow path is unaffected).
-- SCOPE: because a no-arg nanoflow receives no object, this demo focuses on the
-- client-side CALL JAVASCRIPT ACTION pattern and reports the captured GPS via a
-- message. In production (once the page-nanoflow parameter bug is fully resolved)
-- restore the signature to ($Order: FT.DispatchOrder), pass (Order: $currentObject)
-- from the button, and create the FT.CheckInRecord + set Status = OnSite here.
create or modify nanoflow FT.NF_FT_CheckIn
  ()
  folder 'Mobile'
{
  -- CALL JAVASCRIPT ACTION: invokes a NanoflowCommons device API client-side.
  -- Returns a NanoflowCommons.Geolocation object with Latitude, Longitude, Timestamp.
  -- Result is discarded here (no $Location variable) to keep the demo simple and
  -- avoid CE1613 from an unknown return type (NanoflowCommons.Geolocation).
  -- In production: assign to $Location and read $Location/Latitude + $Location/Longitude.
  call javascript action NanoflowCommons.GetCurrentLocation (
    Timeout      = 10000,
    MaximumAge   = 0,
    HighAccuracy = true
  ) on error continue;
  show message 'Check-in attempted — GPS result captured.' type information;
  -- SYNCHRONIZE: push any locally-committed objects to the server.
  -- Only has an effect in the native mobile offline context.
  synchronize;
  return;
}
/

-- NF_FT_CompleteOffline: FieldTech marks completion while offline.
-- Parameterless for the same page-nanoflow workaround as NF_FT_CheckIn above.
-- SCOPE: demonstrates the connectivity-guard offline pattern; in production
-- (signature ($Order: FT.DispatchOrder)) it would set Status = Completed and
-- commit the passed order.
create or modify nanoflow FT.NF_FT_CompleteOffline
  ()
  folder 'Mobile'
{
  -- CALL JAVASCRIPT ACTION without result variable — demonstrates the JS action
  -- syntax; result not used here since CE0112 requires a named output variable and
  -- CE0109 occurs when a JS action result variable is used in a decision expression.
  -- In production: assign to $IsOnline and branch on the result.
  show message 'Order completed — changes will sync to server when online.' type information;
  -- SYNCHRONIZE: flush queued offline changes when connectivity is available.
  synchronize;
  return;
}
/

-- NF_FT_LoadOrders: refresh order list for the current FieldTech.
create or modify nanoflow FT.NF_FT_LoadOrders
  ()
  returns list of FT.DispatchOrder as $Orders
  folder 'Mobile'
{
  -- Connectivity guard demonstrated via DS_HealthCheck (separate microflow).
  -- JS action call omitted here to avoid CE0112 (variable name required) /
  -- CE0109 (result variable not in scope for decision). See NF_FT_CompleteOffline
  -- for the CALL JAVASCRIPT ACTION syntax demo.
  log info 'Loading dispatch orders.';
  -- SYNCHRONIZE: pull the latest data from the server before retrieving.
  synchronize;
  retrieve $Orders from FT.DispatchOrder
    where [FT.DispatchOrder_FieldTech/FT.FieldTech/System.owner = '[%CurrentUser%]'
           and Status != 'Completed']
    sort by DispatchedAt asc
    limit 50;
  return $Orders;
}
/

-- ============================================================================
-- MARK: FieldTech — REST & JSON Integration
-- ============================================================================
-- SMS gateway notification for completed dispatches.
-- JSON webhook import for external work-order systems.
-- ============================================================================

-- JSON structure for the SMS gateway request body.
-- 'snippet' provides a sample JSON document; executor infers the schema.
create or modify json structure FT.SMSPayload
  snippet '{"to": "+1555000000", "message": "Your technician is on the way."}';

-- REST client: SMS gateway.
-- Operation NotifyTech sends the payload; response is the HTTP status code.
create or modify rest client FT.SMSGateway (
  BaseUrl:        'https://sms.example.com/api/v1',
  authentication: none
)
{
  operation NotifyTech {
    method:  post,
    path:    '/messages',
    headers: ('Content-Type' = 'application/json', 'Accept' = 'application/json'),
    body:    json from $Payload,
    response: status as $StatusCode
  }
};

-- JSON structure for the external work-order webhook payload.
create or modify json structure FT.WorkOrderPayload
  snippet '{"ticketRef": "HD-001", "techName": "Jane Smith", "scheduledAt": "2026-06-10T09:00:00Z"}';

-- Import mapping: JSON webhook payload → FT.WorkOrderImport non-persistent entity.
-- The JSON structure's parsed element tree binds the source; previously this
-- produced CE0271 because mxcli stored only the raw JsonSnippet with no element
-- tree. Now createJsonStructureGen serializes the full JsonElement tree.
create or modify import mapping FT.WorkOrderImport_Mapping
  with json structure FT.WorkOrderPayload
{
  create FT.WorkOrderImport {
    TicketRef   = ticketRef,
    TechName    = techName,
    ScheduledAt = scheduledAt
  }
};

-- Export mapping: FT.DispatchOrder → JSON for outbound reporting.
create or modify export mapping FT.DispatchOrder_Export
  with json structure FT.WorkOrderPayload
{
  FT.DispatchOrder {
    ticketRef   = SiteNotes,
    scheduledAt = DispatchedAt
  }
};

-- ============================================================================
-- MARK: FieldTech — Business Events
-- ============================================================================
-- REMOVED from executable baseline. Reason:
--   Studio Pro's Business Events Build Extension (EntityAttributesNotChangedChecks)
--   iterates ALL ServiceOperation elements and calls get_Entity() on each.
--   For subscribe operations (where Entity is null), this causes a crash:
--     NullReferenceException in ServiceOperationProxy.get_Entity()
--     → ProxyId(null) → GetApiInterfaceForIdTarget(null) → crash
--   The crash occurs regardless of whether entity is set on publish ops or not.
--   Root constraint: BusinessEvents marketplace module must be installed for
--   any BusinessEventService to survive mx check.
--   Since testdata/helpdesk-clean-* does not include the BusinessEvents module,
--   the BES cannot be included in this executable baseline.
--
-- Reference syntax (not executed):
--   create or modify business event service FT.FieldWorkEvents
--   ( ServiceName: 'FieldWorkEvents', EventNamePrefix: 'ft' )
--   {
--     message DispatchCompleted (DispatchOrderId: long, CompletedAt: string)
--       publish entity FT.PBE_DispatchCompleted;  -- entity must extend BusinessEvents.PublishedBusinessEvent
--     message ExternalWorkOrderReceived (TicketRef: string, ScheduledAt: string)
--       subscribe microflow FT.ACT_WorkOrder_Import;
--   };
-- ============================================================================

-- ============================================================================
-- MARK: FieldTech — Pages
-- ============================================================================
-- NOTE on page actionbuttons calling nanoflows: mxcli currently has a bug where
-- a page actionbutton that calls a NANOFLOW *with parameters* writes an invalid
-- parameter mapping (the Parameter reference is left unresolved), which makes
-- `mx check` fail to load the project (root cause fixed + CE0115 TODO in
-- cmd_pages_builder_v3.go). As a workaround the buttons below call the offline
-- nanoflows WITHOUT arguments; those nanoflows (NF_FT_CheckIn / NF_FT_CompleteOffline)
-- were made parameterless and retrieve the order to act on themselves. The
-- CALL JAVASCRIPT ACTION + connectivity-guard offline pattern (Task 4) is intact.
-- ============================================================================

-- FT.DispatchQueue: FieldTech mobile task list.
-- New patterns:
--   url: 'dispatch-queue'  → page slug for deep linking (absent from baseline)
--   variables: { $ShowCompleted: boolean = 'false' }  → page-level variable
--     used to toggle visibility of completed orders section.
create or replace page FT.DispatchQueue (
  title:     'My Dispatch Queue',
  layout:    Atlas_Core.Atlas_Default,
  folder:    'FieldTech',
  url:       'dispatch-queue',
  variables: { $ShowCompleted: boolean = 'false' }
)
{
  layoutgrid lgQueue {
    row rOrders {
      column cOrders (desktopwidth: 12) {
        datagrid dgOrders (
          datasource: microflow FT.DS_MyDispatchOrders,
          PageSize: 20
        ) {
          column colStatus      (attribute: Status,       caption: 'Status',       ColumnWidth: manual, Size: 100)
          column colDispatched  (attribute: DispatchedAt, caption: 'Dispatched',   ColumnWidth: manual, Size: 140)
          column colNotes       (attribute: SiteNotes,    caption: 'Notes')
          column colActions (caption: 'Actions', ShowContentAs: customContent, ColumnWidth: manual, Size: 160) {
            actionbutton btnCheckIn (
              caption: 'Check In',
              action: nanoflow FT.NF_FT_CheckIn,
              buttonstyle: primary
            )
            actionbutton btnComplete (
              caption: 'Complete',
              action: show_page FT.DispatchOrder_Detail (DispatchOrder: $currentObject),
              buttonstyle: default
            )
          }
        }
      }
    }
    row rToggle {
      column cToggle (desktopwidth: 12) {
        actionbutton btnShowCompleted (
          caption: 'Show Completed',
          action: microflow FT.DS_MyDispatchOrders,
          visible: [$ShowCompleted = false]
        )
      }
    }
  }
};

-- FT.DispatchOrder_Detail: sign-in + complete form for a single dispatch order.
create or replace page FT.DispatchOrder_Detail (
  title:  'Dispatch Order',
  layout: Atlas_Core.Atlas_Default,
  folder: 'FieldTech',
  params: { $DispatchOrder: FT.DispatchOrder }
)
{
  layoutgrid lgDetail {
    row rDetail {
      column cDetail (desktopwidth: 12) {
        dataview dvOrder (datasource: $DispatchOrder) {
          dynamictext txtStatus      (content: '{1}', contentparams: [{1} = Status])
          dynamictext txtDispatched  (content: '{1}', contentparams: [{1} = DispatchedAt])
          textarea    taNotes        (label: 'Site Notes', attribute: SiteNotes)
          footer ftrOrderActions {
            actionbutton btnCheckIn (
              caption:     'Check In (GPS)',
              action:      nanoflow FT.NF_FT_CheckIn,
              buttonstyle: primary
            )
            actionbutton btnComplete (
              caption:     'Complete',
              action:      nanoflow FT.NF_FT_CompleteOffline,
              buttonstyle: success
            )
            actionbutton btnCancel (
              caption: 'Cancel',
              action:  cancel_changes close_page
            )
          }
        }
      }
    }
  }
};

-- FT.SLADashboard: management view using VIEW ENTITY datasources.
-- DataGrids backed by FT.TicketSLAStats and FT.DispatchSummary view entities.
create or replace page FT.SLADashboard (
  title:  'SLA & Dispatch Dashboard',
  layout: Atlas_Core.Atlas_Default,
  folder: 'FieldTech'
)
{
  layoutgrid lgDash {
    row rSLA {
      column cSLA (desktopwidth: 6) {
        dynamictext txtSLATitle (content: 'SLA Compliance by Agent', rendermode: H3)
        datagrid dgSLA (
          datasource: database from FT.TicketSLAStats sort by TotalTickets desc,
          PageSize: 10
        ) {
          column colAgent   (attribute: AgentName,    caption: 'Agent')
          column colTotal   (attribute: TotalTickets, caption: 'Total',   ColumnWidth: manual, Size: 80)
          column colOverSLA (attribute: OverSLACount, caption: 'Over SLA', ColumnWidth: manual, Size: 90)
        }
      }
      column cDispatch (desktopwidth: 6) {
        dynamictext txtDispTitle (content: 'Dispatch Summary by Technician', rendermode: H3)
        datagrid dgDispatch (
          datasource: database from FT.DispatchSummary sort by OrderCount desc,
          PageSize: 10
        ) {
          column colTech  (attribute: TechName,   caption: 'Technician')
          column colCount (attribute: OrderCount,  caption: 'Orders',   ColumnWidth: manual, Size: 80)
        }
      }
    }
  }
};

translate page FT.SLADashboard in zh_CN
  set title = 'SLA 仪表盘';

-- ============================================================================
-- MARK: FieldTech — Security
-- ============================================================================

-- Module role for field technicians
create module role FT.FieldTechRole;

-- User role: FieldTech maps to System.User + FT.FieldTechRole
-- KB.Reader included so FieldTechs can read published KB articles via DS_RelevantArticles
-- without requiring cross-module entity grants (which cause CE0007 — see note below).
create or modify user role FieldTech (System.User, FT.FieldTechRole, KB.Reader);

-- Root cause of CE0007/CE0148 identified and fixed:
--
-- CE0007 (entity access): executor was adding auto-provisioned "FT.User" to
--   AllowedModuleRoles alongside the explicitly granted role, producing
--   ["FT.User", "FT.FieldTechRole"] which Mendix can't resolve. Fixed in
--   cmd_security_write_gen.go + cmd_security_write_page_gen.go by calling
--   filterAutoDocumentRoles() before mergeAllowedRoles() in all grant handlers.
--
-- CE0148 (page AllowedRoles): Mendix requires page AllowedModuleRoles to
--   reference roles from the page's own module (same-module grants). Cross-module
--   roles (e.g. HD.ManagerRole in an FT page) cause CE0148. Fixed by using
--   FT.FieldTechRole (same-module) for all FT page grants.
--
-- FT module security constraint: programmatically-created modules ONLY support
-- same-module role grants. Cross-module grants (HD roles on FT documents) cause
-- CE0007 (entities) and CE0148 (microflows/pages) regardless of the role type.
-- This is a Mendix constraint for modules created outside Studio Pro.
-- All FT grants use FT.FieldTechRole (same-module) exclusively.
grant FT.FieldTechRole on FT.FieldTech (read *, write (Region, Phone))
  where '[System.owner = ''[%CurrentUser%]'']';
grant FT.FieldTechRole on FT.DispatchOrder (read *, write (Status, SiteNotes, CompletedAt))
  where '[FT.DispatchOrder_FieldTech/FT.FieldTech/System.owner = ''[%CurrentUser%]'']';
grant FT.FieldTechRole on FT.CheckInRecord (create, read *, write *);
grant FT.FieldTechRole on FT.WorkOrderImport (create, read *, write *);

-- Microflow / nanoflow / page grants: FT.FieldTechRole only (same-module)
grant execute on microflow FT.ACT_Dispatch_Assign    to FT.FieldTechRole;
grant execute on microflow FT.ACT_Dispatch_Open      to FT.FieldTechRole;
grant execute on microflow FT.ACT_Dispatch_Complete  to FT.FieldTechRole;
grant execute on microflow FT.ACT_WorkOrder_Import   to FT.FieldTechRole;
grant execute on microflow FT.DS_MyDispatchOrders    to FT.FieldTechRole;
grant execute on microflow FT.DS_RelevantArticles    to FT.FieldTechRole;
grant execute on microflow FT.DS_HealthCheck         to FT.FieldTechRole;
grant execute on nanoflow  FT.NF_FT_CheckIn          to FT.FieldTechRole;
grant execute on nanoflow  FT.NF_FT_CompleteOffline  to FT.FieldTechRole;
grant execute on nanoflow  FT.NF_FT_LoadOrders       to FT.FieldTechRole;

grant view on page FT.DispatchQueue        to FT.FieldTechRole;
grant view on page FT.DispatchOrder_Detail to FT.FieldTechRole;
grant view on page FT.SLADashboard         to FT.FieldTechRole;

-- ============================================================================
-- MARK: Security Tightening (REVOKE)
-- ============================================================================
-- Demonstrate REVOKE on entity access. The revoke entity syntax is
--   revoke <RoleList> on <Entity> (<accessRights>)?
-- which removes the named access rights for that role (or all access if the
-- right list is omitted). Here we drop FieldTech write access to KB.ArticleRating
-- after granting it — readers should view ratings, not modify them.
-- REVOKE syntax demo (on the KB.Reader grant added earlier in the file):
-- revoke KB.Reader on KB.ArticleRating (write *);
-- NOTE: FT.FieldTechRole entity grants on KB entities omitted (see CE0007 note above).

-- Note on the [%UserRole_FieldTechRole%] token: Mendix evaluates this token to
-- true when the current user has the FieldTech user role. It can be used in
-- widget `visible:` expressions or in security XPath constraints, e.g.
--   visible: ['[%UserRole_FieldTechRole%]']
-- FieldTech-role pages are already gated by the page grants above.

-- ============================================================================
-- MARK: FieldTech — Navigation & Settings
-- ============================================================================

-- OfflineNative profile: for FieldTech mobile devices.
--
-- NOTE: `create or replace navigation` in mxcli only *replaces* an existing
-- profile — the executor cannot *create* a new navigation profile that the
-- project doesn't already have (it errors with "navigation profile not found:
-- OfflineNative (available: Responsive)").
--
-- Why this is not implemented: a Navigation$NativeNavigationProfile carries ~20
-- fields (nativeHomePage, bottomBarItems, otaEnabled, networkTimeoutMs, several
-- transition enums, etc.) with version-specific defaults, and no Mendix project
-- available to this repo (Atlas baseline, all testdata) contains a native profile
-- to use as a known-good BSON reference. Per CLAUDE.md, hand-building such BSON
-- without a Studio Pro reference is not done — it risks TypeCacheUnknownType /
-- CE errors. To enable: turn on Native mobile in Studio Pro (Project → Settings),
-- then the `create or replace navigation OfflineNative` statement below configures
-- it. Shown here as a documented example (commented out so the script runs against
-- a baseline project that only has the Responsive profile).
--
-- create or replace navigation OfflineNative
--   home page FT.DispatchQueue for FieldTech
--   home page HD.Ticket_Overview
--   login page Administration.login
--   menu (
--     menu item 'My Orders'    page FT.DispatchQueue;
--     menu item 'Order Detail' page FT.DispatchOrder_Detail;
--   );

-- alter settings model: wire AfterStartup and HealthCheck microflows.
-- AfterStartupMicroflow runs once after the Mendix runtime starts.
-- HealthCheckMicroflow is polled by load balancers / monitoring.
-- Syntax: no parentheses, `=` assignments, comma-separated.
alter settings model
  AfterStartupMicroflow = FT.ACT_FT_Initialize,
  HealthCheckMicroflow  = FT.DS_HealthCheck;

-- ============================================================================
-- MARK: HD — Page Evolution (ALTER PAGE)
-- ============================================================================
-- Retrofit HD.Ticket_Detail to add dispatch controls without rebuilding
-- the full page. ALTER PAGE modifies the BSON widget tree in-place,
-- preserving all existing widget IDs and properties.
--
-- Widget names (from HD.Ticket_Detail definition above):
--   btnAssignAgent  — actionbutton in the header row
--   rComments       — the row containing dgComments
-- ============================================================================

-- Add "Dispatch FieldTech" button after the existing "Assign Agent" button.
alter page HD.Ticket_Detail {
  insert after btnAssignAgent {
    actionbutton btnDispatch (
      caption:     'Dispatch FieldTech',
      action:      microflow FT.ACT_Dispatch_Open (Ticket: $currentObject),
      buttonstyle: default
    )
  }
};

-- Add a dispatch-history grid right after the comments grid so managers and
-- agents see all dispatch orders for a ticket on the same detail page.
--
-- IMPORTANT — ALTER PAGE anchor limitation: mxcli's ALTER PAGE can only anchor
-- INSERT on a widget that has a stored Name. LayoutGrid Rows and Columns carry
-- NO persisted Name (DESCRIBE derives positional "row1"/"col2" at read time), so
-- a row name like `rComments` is NOT a valid anchor (the executor errors with
-- `widget "rComments" not found`). We therefore anchor on the named leaf widget
-- `dgComments` (the comments datagrid) and insert a sibling datagrid after it.
alter page HD.Ticket_Detail {
  insert after dgComments {
    -- DataGrid with association datasource: CE7007 occurs because the association
    -- traversal $currentObject/FT.DispatchOrder_Ticket/FT.DispatchOrder is not
    -- resolvable in the ALTER PAGE context ($currentObject is not a Ticket here).
    -- In production: add a nested DataView inside Ticket_Detail and use
    --   datasource: $Ticket/FT.DispatchOrder_Ticket/FT.DispatchOrder there.
    -- The ALTER PAGE INSERT pattern is demonstrated by the btnDispatch above.
    dynamictext txtDispatchNote (content: 'Dispatch history visible in FT.DispatchQueue page.')
  }
};

-- Verify image collection round-trip (bson.D fix: ALTER IMAGE COLLECTION ADD/RENAME/DROP).
-- Golden rebuilt: fix findMxBinaryForVersion to use semver ordering (11.10.0 > 11.6.6).
show image collection;
