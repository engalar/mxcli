alter settings model
  HashAlgorithm = 'BCrypt',
  BcryptCost = 12,
  JavaVersion = 'Java21',
  RoundingMode = 'HalfUp',
  AllowUserMultipleSessions = true,
  ScheduledEventTimeZoneCode = 'Etc/UTC';

alter settings configuration 'Default'
  DatabaseType = 'Hsqldb',
  DatabaseUrl = '',
  DatabaseName = 'default',
  DatabaseUserName = '',
  DatabasePassword = '',
  HttpPortNumber = 8080,
  ServerPortNumber = 8090,
  ApplicationRootUrl = 'http://localhost:8080/';

alter settings language add 'zh_CN';
alter settings language
  DefaultLanguageCode = 'en_US';

alter settings workflows
  UserEntity = 'System.User',
  DefaultTaskParallelism = 3,
  WorkflowEngineParallelism = 5;

